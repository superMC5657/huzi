import ast

# M1-C JSON 子集 v1：canonical 紧凑 JSON（见 ../RFC.md）。
# 转义仅 5 种（"/\/n/r/t），与 std.jsonq::escape_json_str 同口径；Box 透明、Span 丢弃。
fn json_escape(s: str) -> str {
    let n = len(s)
    let mut res = ""
    let mut i = 0
    while i < n {
        let ch = substring(s, i, i + 1)
        if ch == "\"" {
            res = concat(res, "\\\"")
        } elif ch == "\\" {
            res = concat(res, "\\\\")
        } elif ch == "\n" {
            res = concat(res, "\\n")
        } elif ch == "\r" {
            res = concat(res, "\\r")
        } elif ch == "\t" {
            res = concat(res, "\\t")
        } else {
            res = concat(res, ch)
        }
        i = i + 1
    }
    return res
}

fn json_quoted(s: str) -> str {
    return concat("\"", json_escape(s), "\"")
}

fn strs_to_json(ss: vec<str>) -> str {
    let n = len(ss)
    let mut res = "["
    let mut i = 0
    while i < n {
        if i > 0 {
            res = concat(res, ",")
        }
        res = concat(res, json_quoted(ss[i]))
        i = i + 1
    }
    return concat(res, "]")
}

fn exprs_to_json(es: vec<Box<Expr>>) -> str {
    let n = len(es)
    let mut res = "["
    let mut i = 0
    while i < n {
        if i > 0 {
            res = concat(res, ",")
        }
        res = concat(res, expr_to_json(es[i]))
        i = i + 1
    }
    return concat(res, "]")
}

fn stmts_to_json(ss: vec<Box<Stmt>>) -> str {
    let n = len(ss)
    let mut res = "["
    let mut i = 0
    while i < n {
        if i > 0 {
            res = concat(res, ",")
        }
        res = concat(res, stmt_to_json(ss[i]))
        i = i + 1
    }
    return concat(res, "]")
}

fn expr_to_json(e: Box<Expr>) -> str {
    if e.kind == "num" {
        return concat("{\"kind\":\"num\",\"value\":", to_string(e.num_val), "}")
    }
    if e.kind == "bool" {
        let b = if e.bool_val { "true" } else { "false" }
        return concat("{\"kind\":\"bool\",\"value\":", b, "}")
    }
    if e.kind == "str" {
        return concat("{\"kind\":\"str\",\"value\":", json_quoted(e.str_val), "}")
    }
    if e.kind == "var" {
        return concat("{\"kind\":\"var\",\"name\":", json_quoted(e.name), "}")
    }
    if e.kind == "bin" {
        let l = expr_to_json(e.left)
        let r = expr_to_json(e.right)
        return concat("{\"kind\":\"bin\",\"op\":", json_quoted(e.op), ",\"left\":", l, ",\"right\":", r, "}")
    }
    if e.kind == "un" {
        let o = expr_to_json(e.left)
        return concat("{\"kind\":\"un\",\"op\":", json_quoted(e.op), ",\"operand\":", o, "}")
    }
    if e.kind == "call" {
        let a = exprs_to_json(e.args)
        return concat("{\"kind\":\"call\",\"name\":", json_quoted(e.name), ",\"args\":", a, "}")
    }
    return expr_comp_to_json(e)
}

# 复合形分发（P3 tuple/array/index/enum/try + P3b struct/field/method/fstring + P3c match/closure/variant）。
fn expr_comp_to_json(e: Box<Expr>) -> str {
    if e.kind == "tuple" {
        let t = exprs_to_json(e.args)
        return concat("{\"kind\":\"tuple\",\"elems\":", t, "}")
    }
    if e.kind == "array" {
        let ar = exprs_to_json(e.args)
        return concat("{\"kind\":\"array\",\"elems\":", ar, "}")
    }
    if e.kind == "index" {
        let ab = expr_to_json(e.left)
        let ib = expr_to_json(e.right)
        return concat("{\"kind\":\"index\",\"array\":", ab, ",\"index\":", ib, "}")
    }
    if e.kind == "enum" {
        let ea = exprs_to_json(e.args)
        return concat("{\"kind\":\"enum\",\"name\":", json_quoted(e.name), ",\"args\":", ea, "}")
    }
    if e.kind == "try" {
        let te = expr_to_json(e.left)
        return concat("{\"kind\":\"try\",\"expr\":", te, "}")
    }
    if e.kind == "struct" {
        return concat("{\"kind\":\"struct\",\"name\":", json_quoted(e.name), ",\"fields\":", struct_fields_to_json(e.field_names, e.args), "}")
    }
    if e.kind == "field" {
        let fb = expr_to_json(e.left)
        return concat("{\"kind\":\"field\",\"base\":", fb, ",\"field\":", json_quoted(e.name), "}")
    }
    if e.kind == "method" {
        let mr = expr_to_json(e.left)
        let ma = exprs_to_json(e.args)
        return concat("{\"kind\":\"method\",\"receiver\":", mr, ",\"method\":", json_quoted(e.name), ",\"args\":", ma, "}")
    }
    if e.kind == "fstring" {
        let fa = exprs_to_json(e.args)
        return concat("{\"kind\":\"fstring\",\"template\":", json_quoted(e.str_val), ",\"args\":", fa, "}")
    }
    if e.kind == "match" {
        return match_to_json(e.left, e.match_arms)
    }
    if e.kind == "closure" {
        return closure_to_json(e.field_names, e.left)
    }
    if e.kind == "variant" {
        return concat("{\"kind\":\"variant\",\"name\":", json_quoted(e.name), ",\"bindings\":", strs_to_json(e.field_names), "}")
    }
    return ""
}

# P3c match 单臂：`{"pattern":pat,"guard":g,"body":[stmts]}`（键序固定，无守卫即 true）。
# 非形状臂（var/非 Option-Result 变体等）即 "" 双非零，与 Rust Err 同口径。
fn is_p3c_variant(full: str) -> bool {
    if full == "Option::Some" {
        return true
    }
    if full == "Option::None" {
        return true
    }
    if full == "Result::Ok" {
        return true
    }
    if full == "Result::Err" {
        return true
    }
    return false
}

fn is_p3c_pat(pat: Box<Expr>) -> bool {
    if pat.kind == "num" {
        return true
    }
    if pat.kind == "bool" {
        return true
    }
    if pat.kind == "str" {
        return true
    }
    if pat.kind == "variant" {
        return is_p3c_variant(pat.name)
    }
    return false
}

fn match_arm_to_json(pat: Box<Expr>, guard: Box<Expr>, body: vec<Box<Stmt>>) -> str {
    if !is_p3c_pat(pat) {
        return ""
    }
    let p = expr_to_json(pat)
    if p == "" {
        return ""
    }
    let g = expr_to_json(guard)
    if g == "" {
        return ""
    }
    let b = stmts_to_json(body)
    return concat("{\"pattern\":", p, ",\"guard\":", g, ",\"body\":", b, "}")
}

fn match_arms_to_json(arms: vec<Box<MatchArm>>) -> str {
    let n = len(arms)
    let mut res = "["
    let mut i = 0
    while i < n {
        if i > 0 {
            res = concat(res, ",")
        }
        let a: Box<MatchArm> = arms[i]
        let one = match_arm_to_json(a.pat, a.guard, a.body)
        if one == "" {
            return ""
        }
        res = concat(res, one)
        i = i + 1
    }
    return concat(res, "]")
}

# P3c match：`{"kind":"match","scrutinee":e,"arms":[...]}`（空臂/非形状臂即 "" 双非零）。
fn match_to_json(scrutinee: Box<Expr>, arms: vec<Box<MatchArm>>) -> str {
    if len(arms) == 0 {
        return ""
    }
    let s = expr_to_json(scrutinee)
    if s == "" {
        return ""
    }
    let a = match_arms_to_json(arms)
    if a == "" {
        return ""
    }
    return concat("{\"kind\":\"match\",\"scrutinee\":", s, ",\"arms\":", a, "}")
}

# P3c 闭包：`{"kind":"closure","params":[...],"body":e}`（仅单表达式体，块体无字段存即 ""）。
fn closure_to_json(params: vec<str>, body: Box<Expr>) -> str {
    let b = expr_to_json(body)
    if b == "" {
        return ""
    }
    return concat("{\"kind\":\"closure\",\"params\":", strs_to_json(params), ",\"body\":", b, "}")
}

# P3b 结构字段数组：`[{"name":"x","value":expr},...]`（键序固定 name/value）。
fn struct_fields_to_json(names: vec<str>, vals: vec<Box<Expr>>) -> str {
    let n = len(names)
    let mut res = "["
    let mut i = 0
    while i < n {
        if i > 0 {
            res = concat(res, ",")
        }
        let v = expr_to_json(vals[i])
        res = concat(res, concat("{\"name\":", json_quoted(names[i]), ",\"value\":", v, "}"))
        i = i + 1
    }
    return concat(res, "]")
}

# P3b 类型：只存 name+args（不求解不检查，与 ast_json.rs type_to_json 同键序）。
fn type_to_json(t: Box<TypeRef>) -> str {
    return concat("{\"kind\":\"type\",\"name\":", json_quoted(t.name), ",\"args\":", types_to_json(t.args), "}")
}

fn types_to_json(ts: vec<Box<TypeRef>>) -> str {
    let n = len(ts)
    let mut res = "["
    let mut i = 0
    while i < n {
        if i > 0 {
            res = concat(res, ",")
        }
        res = concat(res, type_to_json(ts[i]))
        i = i + 1
    }
    return concat(res, "]")
}

fn stmt_to_json(s: Box<Stmt>) -> str {
    if s.kind == "let" {
        let e = expr_to_json(s.expr)
        return concat("{\"kind\":\"let\",\"name\":", json_quoted(s.name), ",\"expr\":", e, "}")
    }
    if s.kind == "assign" {
        let e = expr_to_json(s.expr)
        return concat("{\"kind\":\"assign\",\"name\":", json_quoted(s.name), ",\"expr\":", e, "}")
    }
    if s.kind == "if" {
        let c = expr_to_json(s.expr)
        let t = stmts_to_json(s.body)
        let el = stmts_to_json(s.else_body)
        return concat("{\"kind\":\"if\",\"cond\":", c, ",\"then\":", t, ",\"else\":", el, "}")
    }
    if s.kind == "while" {
        let c = expr_to_json(s.expr)
        let b = stmts_to_json(s.body)
        return concat("{\"kind\":\"while\",\"cond\":", c, ",\"body\":", b, "}")
    }
    if s.kind == "return" {
        let e = expr_to_json(s.expr)
        return concat("{\"kind\":\"return\",\"expr\":", e, "}")
    }
    if s.kind == "print" {
        let e = expr_to_json(s.expr)
        return concat("{\"kind\":\"print\",\"expr\":", e, "}")
    }
    if s.kind == "expr" {
        let e = expr_to_json(s.expr)
        return concat("{\"kind\":\"expr\",\"expr\":", e, "}")
    }
    return ""
}

fn fn_to_json(f: Box<FnDef>) -> str {
    let p = strs_to_json(f.params)
    let b = stmts_to_json(f.body)
    return concat("{\"name\":", json_quoted(f.name), ",\"params\":", p, ",\"body\":", b, "}")
}

fn fns_to_json(fns: vec<Box<FnDef>>) -> str {
    let n = len(fns)
    let mut res = "["
    let mut i = 0
    while i < n {
        if i > 0 {
            res = concat(res, ",")
        }
        res = concat(res, fn_to_json(fns[i]))
        i = i + 1
    }
    return concat(res, "]")
}

fn program_to_json(p: Box<Program>) -> str {
    let f = fns_to_json(p.fns)
    let m = stmts_to_json(p.main_body)
    return concat("{\"fns\":", f, ",\"main\":", m, "}")
}
