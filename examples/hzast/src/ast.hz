# P3 复合值：扁平字符串化存储（Huzi match 绑定 vec 传参受限，故 Tuple/Arr 存
# 已拼接串 + 个数，不存 vec；Some/Ok 存内层串；索引经 split 重建 let 绑定 vec）。
# P3b 结构体：扁平存名 + 已拼接 `k=v` 串 + 字段数（field 经 split 查名，method 按名静态分发直调）。
enum Value {
    Num(i32),
    Bool(bool),
    StrVal(str),
    Nil,
    Tuple(str, i32),
    Arr(str, i32),
    OptSome(str),
    OptNone,
    ResOk(str),
    ResErr(str),
    Struct(str, str, i32),
}

fn val_num(n: i32) -> Value {
    return Value::Num(n)
}

fn val_bool(b: bool) -> Value {
    return Value::Bool(b)
}

fn val_str(s: str) -> Value {
    return Value::StrVal(s)
}

fn val_nil() -> Value {
    return Value::Nil
}

fn val_tuple_strs(vs: vec<str>) -> Value {
    return Value::Tuple(strs_join(vs), len(vs))
}

fn val_arr_strs(vs: vec<str>) -> Value {
    return Value::Arr(strs_join(vs), len(vs))
}

fn val_some_str(s: str) -> Value {
    return Value::OptSome(s)
}

fn val_none() -> Value {
    return Value::OptNone
}

fn val_ok_str(s: str) -> Value {
    return Value::ResOk(s)
}

fn val_err(e: str) -> Value {
    return Value::ResErr(e)
}

fn val_some(v: Value) -> Value {
    return Value::OptSome(val_to_string(v))
}

fn val_ok(v: Value) -> Value {
    return Value::ResOk(val_to_string(v))
}

fn val_tuple(vs: vec<str>) -> Value {
    return Value::Tuple(strs_join(vs), len(vs))
}

fn val_arr(vs: vec<str>) -> Value {
    return Value::Arr(strs_join(vs), len(vs))
}

# P3b 结构值：名 + `k=v` 已拼接串 + 字段数（k/v 内不含 `, `/`=`，见构造侧约定）。
fn val_struct(sname: str, names: vec<str>, vals: vec<str>) -> Value {
    let n = len(names)
    let mut pairs = vec<str>()
    let mut i = 0
    while i < n {
        push(pairs, concat(names[i], "=", vals[i]))
        i = i + 1
    }
    return Value::Struct(sname, strs_join(pairs), n)
}

fn strs_join(vs: vec<str>) -> str {
    let n = len(vs)
    let mut res = ""
    let mut i = 0
    while i < n {
        if i > 0 {
            res = concat(res, ", ")
        }
        res = concat(res, vs[i])
        i = i + 1
    }
    return res
}

fn vals_join(vs: vec<str>) -> str {
    return strs_join(vs)
}

fn val_to_string(v: Value) -> str {
    return match v {
    Value::Num(n) => to_string(n),
    Value::Bool(b) => if b { "true" } else { "false" },
    Value::StrVal(s) => s,
    Value::Nil => "nil",
    Value::Tuple(joined, count) => concat("(", joined, ")"),
    Value::Arr(joined, count) => concat("[", joined, "]"),
    Value::OptSome(s) => concat("Some(", s, ")"),
    Value::OptNone => "None",
    Value::ResOk(s) => concat("Ok(", s, ")"),
    Value::ResErr(e) => concat("Err(", e, ")"),
    Value::Struct(sname, joined, count) => concat(concat(sname, "{"), concat(joined, "}")),
}
}

fn val_to_int(v: Value) -> i32 {
    return match v {
    Value::Num(n) => n,
    Value::Bool(b) => if b { 1 } else { 0 },
    Value::StrVal(s) => parse_int(s).1,
    Value::Nil => 0,
    Value::Tuple(joined, count) => count,
    Value::Arr(joined, count) => count,
    Value::OptSome(s) => parse_int(s).1,
    Value::OptNone => 0,
    Value::ResOk(s) => parse_int(s).1,
    Value::ResErr(e) => 0,
    Value::Struct(sname, joined, count) => count,
}
}

fn val_to_bool(v: Value) -> bool {
    return match v {
    Value::Num(n) => n != 0,
    Value::Bool(b) => b,
    Value::StrVal(s) => len(s) > 0,
    Value::Nil => false,
    Value::Tuple(joined, count) => count > 0,
    Value::Arr(joined, count) => count > 0,
    Value::OptSome(s) => true,
    Value::OptNone => false,
    Value::ResOk(s) => true,
    Value::ResErr(e) => false,
    Value::Struct(sname, joined, count) => count > 0,
}
}

struct Expr {
    kind: str,
    op: str,
    name: str,
    num_val: i32,
    bool_val: bool,
    str_val: str,
    left: Box<Expr>,
    right: Box<Expr>,
    args: vec<Box<Expr>>,
    field_names: vec<str>,
}

fn expr_num(n: i32) -> Box<Expr> {
    return box(Expr { kind: "num", op: "", name: "", num_val: n, bool_val: false, str_val: "", left: null, right: null, args: vec<Box<Expr>>(), field_names: vec<str>() })
}

fn expr_bool(b: bool) -> Box<Expr> {
    return box(Expr { kind: "bool", op: "", name: "", num_val: 0, bool_val: b, str_val: "", left: null, right: null, args: vec<Box<Expr>>(), field_names: vec<str>() })
}

fn expr_str(s: str) -> Box<Expr> {
    return box(Expr { kind: "str", op: "", name: "", num_val: 0, bool_val: false, str_val: s, left: null, right: null, args: vec<Box<Expr>>(), field_names: vec<str>() })
}

fn expr_var(name: str) -> Box<Expr> {
    return box(Expr { kind: "var", op: "", name: name, num_val: 0, bool_val: false, str_val: "", left: null, right: null, args: vec<Box<Expr>>(), field_names: vec<str>() })
}

fn expr_bin(op: str, left: Box<Expr>, right: Box<Expr>) -> Box<Expr> {
    return box(Expr { kind: "bin", op: op, name: "", num_val: 0, bool_val: false, str_val: "", left: left, right: right, args: vec<Box<Expr>>(), field_names: vec<str>() })
}

fn expr_un(op: str, operand: Box<Expr>) -> Box<Expr> {
    return box(Expr { kind: "un", op: op, name: "", num_val: 0, bool_val: false, str_val: "", left: operand, right: null, args: vec<Box<Expr>>(), field_names: vec<str>() })
}

fn expr_call(name: str, args: vec<Box<Expr>>) -> Box<Expr> {
    return box(Expr { kind: "call", op: "", name: name, num_val: 0, bool_val: false, str_val: "", left: null, right: null, args: args, field_names: vec<str>() })
}

# P3 复合值形状：复用既有字段（args 作 elems，left/right 作 array/index，name+args 作 enum，left 作 try 内层）。
fn expr_tuple(elems: vec<Box<Expr>>) -> Box<Expr> {
    return box(Expr { kind: "tuple", op: "", name: "", num_val: 0, bool_val: false, str_val: "", left: null, right: null, args: elems, field_names: vec<str>() })
}

fn expr_array(elems: vec<Box<Expr>>) -> Box<Expr> {
    return box(Expr { kind: "array", op: "", name: "", num_val: 0, bool_val: false, str_val: "", left: null, right: null, args: elems, field_names: vec<str>() })
}

fn expr_index(arr: Box<Expr>, idx: Box<Expr>) -> Box<Expr> {
    return box(Expr { kind: "index", op: "", name: "", num_val: 0, bool_val: false, str_val: "", left: arr, right: idx, args: vec<Box<Expr>>(), field_names: vec<str>() })
}

fn expr_enum(enum_name: str, variant: str, args: vec<Box<Expr>>) -> Box<Expr> {
    return box(Expr { kind: "enum", op: "", name: concat(enum_name, "::", variant), num_val: 0, bool_val: false, str_val: "", left: null, right: null, args: args, field_names: vec<str>() })
}

fn expr_try(inner: Box<Expr>) -> Box<Expr> {
    return box(Expr { kind: "try", op: "", name: "", num_val: 0, bool_val: false, str_val: "", left: inner, right: null, args: vec<Box<Expr>>(), field_names: vec<str>() })
}

# P3b 结构/方法/fstring：struct 用 name+field_names+args；field 用 left+name；
# method 用 left+name+args；fstring 用 str_val+args（沿用扁平复用方法学）。
fn expr_struct(sname: str, fnames: vec<str>, fexprs: vec<Box<Expr>>) -> Box<Expr> {
    return box(Expr { kind: "struct", op: "", name: sname, num_val: 0, bool_val: false, str_val: "", left: null, right: null, args: fexprs, field_names: fnames })
}

fn expr_field(base: Box<Expr>, field: str) -> Box<Expr> {
    return box(Expr { kind: "field", op: "", name: field, num_val: 0, bool_val: false, str_val: "", left: base, right: null, args: vec<Box<Expr>>(), field_names: vec<str>() })
}

fn expr_method(recv: Box<Expr>, method: str, margs: vec<Box<Expr>>) -> Box<Expr> {
    return box(Expr { kind: "method", op: "", name: method, num_val: 0, bool_val: false, str_val: "", left: recv, right: null, args: margs, field_names: vec<str>() })
}

fn expr_fstring(tpl: str, fargs: vec<Box<Expr>>) -> Box<Expr> {
    return box(Expr { kind: "fstring", op: "", name: "", num_val: 0, bool_val: false, str_val: tpl, left: null, right: null, args: fargs, field_names: vec<str>() })
}

# P3b 类型：只存 name+args（不求解不检查，与 ast_json.rs type_to_json 同键序）。
struct TypeRef {
    name: str,
    args: vec<Box<TypeRef>>,
}

fn type_atom(name: str) -> Box<TypeRef> {
    return box(TypeRef { name: name, args: vec<Box<TypeRef>>() })
}

fn type_applied(name: str, args: vec<Box<TypeRef>>) -> Box<TypeRef> {
    return box(TypeRef { name: name, args: args })
}

struct Stmt {
    kind: str,
    name: str,
    expr: Box<Expr>,
    body: vec<Box<Stmt>>,
    else_body: vec<Box<Stmt>>,
}

fn stmt_let(name: str, e: Box<Expr>) -> Box<Stmt> {
    return box(Stmt { kind: "let", name: name, expr: e, body: vec<Box<Stmt>>(), else_body: vec<Box<Stmt>>() })
}

fn stmt_assign(name: str, e: Box<Expr>) -> Box<Stmt> {
    return box(Stmt { kind: "assign", name: name, expr: e, body: vec<Box<Stmt>>(), else_body: vec<Box<Stmt>>() })
}

fn stmt_if(cond: Box<Expr>, then_b: vec<Box<Stmt>>, else_b: vec<Box<Stmt>>) -> Box<Stmt> {
    return box(Stmt { kind: "if", name: "", expr: cond, body: then_b, else_body: else_b })
}

fn stmt_while(cond: Box<Expr>, body: vec<Box<Stmt>>) -> Box<Stmt> {
    return box(Stmt { kind: "while", name: "", expr: cond, body: body, else_body: vec<Box<Stmt>>() })
}

fn stmt_return(e: Box<Expr>) -> Box<Stmt> {
    return box(Stmt { kind: "return", name: "", expr: e, body: vec<Box<Stmt>>(), else_body: vec<Box<Stmt>>() })
}

fn stmt_print(e: Box<Expr>) -> Box<Stmt> {
    return box(Stmt { kind: "print", name: "", expr: e, body: vec<Box<Stmt>>(), else_body: vec<Box<Stmt>>() })
}

fn stmt_expr(e: Box<Expr>) -> Box<Stmt> {
    return box(Stmt { kind: "expr", name: "", expr: e, body: vec<Box<Stmt>>(), else_body: vec<Box<Stmt>>() })
}

struct FnDef {
    name: str,
    params: vec<str>,
    body: vec<Box<Stmt>>,
}

fn fn_def(name: str, params: vec<str>, body: vec<Box<Stmt>>) -> Box<FnDef> {
    return box(FnDef { name: name, params: params, body: body })
}

struct Program {
    fns: vec<Box<FnDef>>,
    main_body: vec<Box<Stmt>>,
}

fn program_new(fns: vec<Box<FnDef>>, main_body: vec<Box<Stmt>>) -> Box<Program> {
    return box(Program { fns: fns, main_body: main_body })
}
