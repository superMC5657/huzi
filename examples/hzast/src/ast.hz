enum Value {
    Num(i32),
    Bool(bool),
    StrVal(str),
    Nil,
}

fn val_num(n: i32) -> Value {
    return Value::Num(n)
}

fn val_bool(b: bool) -> Value {
    return Value::Bool(b)
}

fn val_str(s: str) -> Value {
    return Value::StrVal(s)
}

fn val_nil() -> Value {
    return Value::Nil
}

fn val_to_string(v: Value) -> str {
    return match v {
    Value::Num(n) => to_string(n),
    Value::Bool(b) => if b { "true" } else { "false" },
    Value::StrVal(s) => s,
    Value::Nil => "nil",
}
}

fn val_to_int(v: Value) -> i32 {
    return match v {
    Value::Num(n) => n,
    Value::Bool(b) => if b { 1 } else { 0 },
    Value::StrVal(s) => parse_int(s).1,
    Value::Nil => 0,
}
}

fn val_to_bool(v: Value) -> bool {
    return match v {
    Value::Num(n) => n != 0,
    Value::Bool(b) => b,
    Value::StrVal(s) => len(s) > 0,
    Value::Nil => false,
}
}

struct Expr {
    kind: str,
    op: str,
    name: str,
    num_val: i32,
    bool_val: bool,
    str_val: str,
    left: Box<Expr>,
    right: Box<Expr>,
    args: vec<Box<Expr>>,
}

fn expr_num(n: i32) -> Box<Expr> {
    return box(Expr { kind: "num", op: "", name: "", num_val: n, bool_val: false, str_val: "", left: null, right: null, args: vec<Box<Expr>>() })
}

fn expr_bool(b: bool) -> Box<Expr> {
    return box(Expr { kind: "bool", op: "", name: "", num_val: 0, bool_val: b, str_val: "", left: null, right: null, args: vec<Box<Expr>>() })
}

fn expr_str(s: str) -> Box<Expr> {
    return box(Expr { kind: "str", op: "", name: "", num_val: 0, bool_val: false, str_val: s, left: null, right: null, args: vec<Box<Expr>>() })
}

fn expr_var(name: str) -> Box<Expr> {
    return box(Expr { kind: "var", op: "", name: name, num_val: 0, bool_val: false, str_val: "", left: null, right: null, args: vec<Box<Expr>>() })
}

fn expr_bin(op: str, left: Box<Expr>, right: Box<Expr>) -> Box<Expr> {
    return box(Expr { kind: "bin", op: op, name: "", num_val: 0, bool_val: false, str_val: "", left: left, right: right, args: vec<Box<Expr>>() })
}

fn expr_un(op: str, operand: Box<Expr>) -> Box<Expr> {
    return box(Expr { kind: "un", op: op, name: "", num_val: 0, bool_val: false, str_val: "", left: operand, right: null, args: vec<Box<Expr>>() })
}

fn expr_call(name: str, args: vec<Box<Expr>>) -> Box<Expr> {
    return box(Expr { kind: "call", op: "", name: name, num_val: 0, bool_val: false, str_val: "", left: null, right: null, args: args })
}

struct Stmt {
    kind: str,
    name: str,
    expr: Box<Expr>,
    body: vec<Box<Stmt>>,
    else_body: vec<Box<Stmt>>,
}

fn stmt_let(name: str, e: Box<Expr>) -> Box<Stmt> {
    return box(Stmt { kind: "let", name: name, expr: e, body: vec<Box<Stmt>>(), else_body: vec<Box<Stmt>>() })
}

fn stmt_assign(name: str, e: Box<Expr>) -> Box<Stmt> {
    return box(Stmt { kind: "assign", name: name, expr: e, body: vec<Box<Stmt>>(), else_body: vec<Box<Stmt>>() })
}

fn stmt_if(cond: Box<Expr>, then_b: vec<Box<Stmt>>, else_b: vec<Box<Stmt>>) -> Box<Stmt> {
    return box(Stmt { kind: "if", name: "", expr: cond, body: then_b, else_body: else_b })
}

fn stmt_while(cond: Box<Expr>, body: vec<Box<Stmt>>) -> Box<Stmt> {
    return box(Stmt { kind: "while", name: "", expr: cond, body: body, else_body: vec<Box<Stmt>>() })
}

fn stmt_return(e: Box<Expr>) -> Box<Stmt> {
    return box(Stmt { kind: "return", name: "", expr: e, body: vec<Box<Stmt>>(), else_body: vec<Box<Stmt>>() })
}

fn stmt_print(e: Box<Expr>) -> Box<Stmt> {
    return box(Stmt { kind: "print", name: "", expr: e, body: vec<Box<Stmt>>(), else_body: vec<Box<Stmt>>() })
}

fn stmt_expr(e: Box<Expr>) -> Box<Stmt> {
    return box(Stmt { kind: "expr", name: "", expr: e, body: vec<Box<Stmt>>(), else_body: vec<Box<Stmt>>() })
}

struct FnDef {
    name: str,
    params: vec<str>,
    body: vec<Box<Stmt>>,
}

fn fn_def(name: str, params: vec<str>, body: vec<Box<Stmt>>) -> Box<FnDef> {
    return box(FnDef { name: name, params: params, body: body })
}

struct Program {
    fns: vec<Box<FnDef>>,
    main_body: vec<Box<Stmt>>,
}

fn program_new(fns: vec<Box<FnDef>>, main_body: vec<Box<Stmt>>) -> Box<Program> {
    return box(Program { fns: fns, main_body: main_body })
}
