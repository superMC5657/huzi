fn j_parse_expr_bin_rest(s: str, pos: vec<i32>) -> (bool, Box<Expr>) {
    if !jparse_base::j_expect(s, pos, ",") {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect_key(s, pos, "op") {
        return (false, ast::expr_num(0))
    }
    let opr = jparse_base::j_parse_string(s, pos)
    if !opr.0 {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_is_bin_op(opr.1) {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect(s, pos, ",") {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect_key(s, pos, "left") {
        return (false, ast::expr_num(0))
    }
    let lr = j_parse_expr(s, pos)
    if !lr.0 {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect(s, pos, ",") {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect_key(s, pos, "right") {
        return (false, ast::expr_num(0))
    }
    let rr = j_parse_expr(s, pos)
    if !rr.0 {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect(s, pos, "}") {
        return (false, ast::expr_num(0))
    }
    return (true, ast::expr_bin(opr.1, lr.1, rr.1))
}

fn j_parse_expr_un_rest(s: str, pos: vec<i32>) -> (bool, Box<Expr>) {
    if !jparse_base::j_expect(s, pos, ",") {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect_key(s, pos, "op") {
        return (false, ast::expr_num(0))
    }
    let opr = jparse_base::j_parse_string(s, pos)
    if !opr.0 {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_is_un_op(opr.1) {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect(s, pos, ",") {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect_key(s, pos, "operand") {
        return (false, ast::expr_num(0))
    }
    let or = j_parse_expr(s, pos)
    if !or.0 {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect(s, pos, "}") {
        return (false, ast::expr_num(0))
    }
    return (true, ast::expr_un(opr.1, or.1))
}

fn j_parse_expr_call_rest(s: str, pos: vec<i32>) -> (bool, Box<Expr>) {
    if !jparse_base::j_expect(s, pos, ",") {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect_key(s, pos, "name") {
        return (false, ast::expr_num(0))
    }
    let nr = jparse_base::j_parse_string(s, pos)
    if !nr.0 {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect(s, pos, ",") {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect_key(s, pos, "args") {
        return (false, ast::expr_num(0))
    }
    let ar = j_parse_expr_array(s, pos)
    if !ar.0 {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect(s, pos, "}") {
        return (false, ast::expr_num(0))
    }
    return (true, ast::expr_call(nr.1, ar.1))
}

# P3 复合形状逆解析：tuple/array 复用 elems 数组；index 双 expr；enum 拆 name::variant；try 单 expr。
fn j_parse_expr_tuple_rest(s: str, pos: vec<i32>) -> (bool, Box<Expr>) {
    if !jparse_base::j_expect(s, pos, ",") {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect_key(s, pos, "elems") {
        return (false, ast::expr_num(0))
    }
    let ar = j_parse_expr_array(s, pos)
    if !ar.0 {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect(s, pos, "}") {
        return (false, ast::expr_num(0))
    }
    return (true, ast::expr_tuple(ar.1))
}

fn j_parse_expr_array_lit_rest(s: str, pos: vec<i32>) -> (bool, Box<Expr>) {
    if !jparse_base::j_expect(s, pos, ",") {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect_key(s, pos, "elems") {
        return (false, ast::expr_num(0))
    }
    let ar = j_parse_expr_array(s, pos)
    if !ar.0 {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect(s, pos, "}") {
        return (false, ast::expr_num(0))
    }
    return (true, ast::expr_array(ar.1))
}

fn j_parse_expr_index_rest(s: str, pos: vec<i32>) -> (bool, Box<Expr>) {
    if !jparse_base::j_expect(s, pos, ",") {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect_key(s, pos, "array") {
        return (false, ast::expr_num(0))
    }
    let ar = j_parse_expr(s, pos)
    if !ar.0 {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect(s, pos, ",") {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect_key(s, pos, "index") {
        return (false, ast::expr_num(0))
    }
    let ir = j_parse_expr(s, pos)
    if !ir.0 {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect(s, pos, "}") {
        return (false, ast::expr_num(0))
    }
    return (true, ast::expr_index(ar.1, ir.1))
}

fn j_split_enum_name(full: str) -> (bool, str, str) {
    let n = len(full)
    let mut i = 0
    while i + 1 < n {
        if substring(full, i, i + 2) == "::" {
            return (true, substring(full, 0, i), substring(full, i + 2, n))
        }
        i = i + 1
    }
    return (false, "", "")
}

fn j_parse_expr_enum_rest(s: str, pos: vec<i32>) -> (bool, Box<Expr>) {
    if !jparse_base::j_expect(s, pos, ",") {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect_key(s, pos, "name") {
        return (false, ast::expr_num(0))
    }
    let nr = jparse_base::j_parse_string(s, pos)
    if !nr.0 {
        return (false, ast::expr_num(0))
    }
    let sp = j_split_enum_name(nr.1)
    if !sp.0 {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect(s, pos, ",") {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect_key(s, pos, "args") {
        return (false, ast::expr_num(0))
    }
    let ar = j_parse_expr_array(s, pos)
    if !ar.0 {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect(s, pos, "}") {
        return (false, ast::expr_num(0))
    }
    return (true, ast::expr_enum(sp.1, sp.2, ar.1))
}

fn j_parse_expr_try_rest(s: str, pos: vec<i32>) -> (bool, Box<Expr>) {
    if !jparse_base::j_expect(s, pos, ",") {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect_key(s, pos, "expr") {
        return (false, ast::expr_num(0))
    }
    let er = j_parse_expr(s, pos)
    if !er.0 {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect(s, pos, "}") {
        return (false, ast::expr_num(0))
    }
    return (true, ast::expr_try(er.1))
}

fn j_parse_expr_array(s: str, pos: vec<i32>) -> (bool, vec<Box<Expr>>) {
    if !jparse_base::j_expect(s, pos, "[") {
        return (false, vec<Box<Expr>>())
    }
    let mut out = vec<Box<Expr>>()
    if jparse_base::j_expect(s, pos, "]") {
        return (true, out)
    }
    let e0 = j_parse_expr(s, pos)
    if !e0.0 {
        return (false, vec<Box<Expr>>())
    }
    push(out, e0.1)
    while jparse_base::j_expect(s, pos, ",") {
        let e = j_parse_expr(s, pos)
        if !e.0 {
            return (false, vec<Box<Expr>>())
        }
        push(out, e.1)
    }
    if !jparse_base::j_expect(s, pos, "]") {
        return (false, vec<Box<Expr>>())
    }
    return (true, out)
}

fn j_parse_expr(s: str, pos: vec<i32>) -> (bool, Box<Expr>) {
    if !jparse_base::j_expect(s, pos, "{") {
        return (false, ast::expr_num(0))
    }
    if !jparse_base::j_expect_key(s, pos, "kind") {
        return (false, ast::expr_num(0))
    }
    let kr = jparse_base::j_parse_string(s, pos)
    if !kr.0 {
        return (false, ast::expr_num(0))
    }
    if kr.1 == "num" {
        return j_parse_expr_num_rest(s, pos)
    }
    if kr.1 == "bool" {
        return j_parse_expr_bool_rest(s, pos)
    }
    if kr.1 == "str" {
        return j_parse_expr_str_rest(s, pos)
    }
    if kr.1 == "var" {
        return j_parse_expr_var_rest(s, pos)
    }
    if kr.1 == "bin" {
        return j_parse_expr_bin_rest(s, pos)
    }
    if kr.1 == "un" {
        return j_parse_expr_un_rest(s, pos)
    }
    if kr.1 == "call" {
        return j_parse_expr_call_rest(s, pos)
    }
    if kr.1 == "tuple" {
        return j_parse_expr_tuple_rest(s, pos)
    }
    if kr.1 == "array" {
        return j_parse_expr_array_lit_rest(s, pos)
    }
    if kr.1 == "index" {
        return j_parse_expr_index_rest(s, pos)
    }
    if kr.1 == "enum" {
        return j_parse_expr_enum_rest(s, pos)
    }
    if kr.1 == "try" {
        return j_parse_expr_try_rest(s, pos)
    }
    if kr.1 == "struct" {
        return jparse_p3b::j_parse_expr_struct_rest(s, pos)
    }
    if kr.1 == "field" {
        return jparse_p3b::j_parse_expr_field_rest(s, pos)
    }
    if kr.1 == "method" {
        return jparse_p3b::j_parse_expr_method_rest(s, pos)
    }
    if kr.1 == "fstring" {
        return jparse_p3b::j_parse_expr_fstring_rest(s, pos)
    }
    return (false, ast::expr_num(0))
}
