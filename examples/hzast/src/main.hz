import ast
import eval
import dump
import core.assert

fn test_arithmetic() -> i32 {
    // (3 + 4) * 5 - 10 = 25
    let add_e = ast::expr_bin("+", ast::expr_num(3), ast::expr_num(4))
    let mul_e = ast::expr_bin("*", add_e, ast::expr_num(5))
    let sub_e = ast::expr_bin("-", mul_e, ast::expr_num(10))
    let env: Box<Env> = eval::env_new
    let fns = vec<Box<FnDef>>()
    let v = eval::eval_expr(sub_e, env, fns)
    assert::assert_eq_i32(ast::val_to_int(v), 25)
    return 0
}

fn test_variables_and_assign() -> i32 {
    // let x = 10; x = x + 20; return x * 2; => 60
    let mut stmts = vec<Box<Stmt>>()
    push(stmts, ast::stmt_let("x", ast::expr_num(10)))
    let add_e = ast::expr_bin("+", ast::expr_var("x"), ast::expr_num(20))
    push(stmts, ast::stmt_assign("x", add_e))
    let mul_e = ast::expr_bin("*", ast::expr_var("x"), ast::expr_num(2))
    push(stmts, ast::stmt_return(mul_e))
    let env: Box<Env> = eval::env_new
    let fns = vec<Box<FnDef>>()
    let res = eval::eval_block(stmts, env, fns)
    assert::assert_true(res.0)
    assert::assert_eq_i32(ast::val_to_int(res.1), 60)
    return 0
}

fn test_conditional_if() -> i32 {
    // let a = 15; let r = 0; if a > 10 { r = 100 } else { r = 200 }; return r; => 100
    let mut stmts = vec<Box<Stmt>>()
    push(stmts, ast::stmt_let("a", ast::expr_num(15)))
    push(stmts, ast::stmt_let("r", ast::expr_num(0)))
    let cond = ast::expr_bin(">", ast::expr_var("a"), ast::expr_num(10))
    let mut then_b = vec<Box<Stmt>>()
    push(then_b, ast::stmt_assign("r", ast::expr_num(100)))
    let mut else_b = vec<Box<Stmt>>()
    push(else_b, ast::stmt_assign("r", ast::expr_num(200)))
    push(stmts, ast::stmt_if(cond, then_b, else_b))
    push(stmts, ast::stmt_return(ast::expr_var("r")))
    let env: Box<Env> = eval::env_new
    let fns = vec<Box<FnDef>>()
    let res = eval::eval_block(stmts, env, fns)
    assert::assert_true(res.0)
    assert::assert_eq_i32(ast::val_to_int(res.1), 100)
    return 0
}

fn test_while_loop() -> i32 {
    // let sum = 0; let i = 1; while i <= 10 { sum = sum + i; i = i + 1 }; return sum; => 55
    let mut stmts = vec<Box<Stmt>>()
    push(stmts, ast::stmt_let("sum", ast::expr_num(0)))
    push(stmts, ast::stmt_let("i", ast::expr_num(1)))
    let cond = ast::expr_bin("<=", ast::expr_var("i"), ast::expr_num(10))
    let mut loop_body = vec<Box<Stmt>>()
    let sum_add = ast::expr_bin("+", ast::expr_var("sum"), ast::expr_var("i"))
    push(loop_body, ast::stmt_assign("sum", sum_add))
    let i_add = ast::expr_bin("+", ast::expr_var("i"), ast::expr_num(1))
    push(loop_body, ast::stmt_assign("i", i_add))
    push(stmts, ast::stmt_while(cond, loop_body))
    push(stmts, ast::stmt_return(ast::expr_var("sum")))
    let env: Box<Env> = eval::env_new
    let fns = vec<Box<FnDef>>()
    let res = eval::eval_block(stmts, env, fns)
    assert::assert_true(res.0)
    assert::assert_eq_i32(ast::val_to_int(res.1), 55)
    return 0
}

fn test_functions_and_recursion() -> i32 {
    // fn fact(n) { if n <= 1 { return 1 }; return n * fact(n - 1); }
    // fact(5) => 120
    let mut fact_params = vec<str>()
    push(fact_params, "n")
    let mut fact_body = vec<Box<Stmt>>()
    let cond = ast::expr_bin("<=", ast::expr_var("n"), ast::expr_num(1))
    let mut then_b = vec<Box<Stmt>>()
    push(then_b, ast::stmt_return(ast::expr_num(1)))
    let else_b = vec<Box<Stmt>>()
    push(fact_body, ast::stmt_if(cond, then_b, else_b))
    let mut call_args = vec<Box<Expr>>()
    let n_sub = ast::expr_bin("-", ast::expr_var("n"), ast::expr_num(1))
    push(call_args, n_sub)
    let fact_recur = ast::expr_call("fact", call_args)
    let ret_expr = ast::expr_bin("*", ast::expr_var("n"), fact_recur)
    push(fact_body, ast::stmt_return(ret_expr))
    let fact_fn = ast::fn_def("fact", fact_params, fact_body)
    let mut fns = vec<Box<FnDef>>()
    push(fns, fact_fn)
    let mut main_body = vec<Box<Stmt>>()
    let mut main_call_args = vec<Box<Expr>>()
    push(main_call_args, ast::expr_num(5))
    push(main_body, ast::stmt_return(ast::expr_call("fact", main_call_args)))
    let prog: Box<Program> = ast::program_new(fns, main_body)
    let res = eval::eval_program(prog)
    assert::assert_eq_i32(ast::val_to_int(res), 120)
    return 0
}

fn test_string_operations() -> i32 {
    let concat_e = ast::expr_bin("+", ast::expr_str("hello "), ast::expr_str("huzi"))
    let env: Box<Env> = eval::env_new
    let fns = vec<Box<FnDef>>()
    let res = eval::eval_expr(concat_e, env, fns)
    assert::assert_eq_str(ast::val_to_string(res), "hello huzi")
    return 0
}

fn test_tuple() -> i32 {
    let mut elems = vec<Box<Expr>>()
    push(elems, ast::expr_num(10))
    push(elems, ast::expr_num(20))
    let e = ast::expr_tuple(elems)
    let res = eval::eval_expr(e, eval::env_new, vec<Box<FnDef>>())
    assert::assert_eq_str(ast::val_to_string(res), "(10, 20)")
    assert::assert_eq_i32(ast::val_to_int(res), 2)
    return 0
}

fn test_array() -> i32 {
    let mut elems = vec<Box<Expr>>()
    push(elems, ast::expr_num(1))
    push(elems, ast::expr_num(2))
    push(elems, ast::expr_num(3))
    let e = ast::expr_array(elems)
    let res = eval::eval_expr(e, eval::env_new, vec<Box<FnDef>>())
    assert::assert_eq_str(ast::val_to_string(res), "[1, 2, 3]")
    assert::assert_eq_i32(ast::val_to_int(res), 3)
    return 0
}

fn test_index() -> i32 {
    let mut elems = vec<Box<Expr>>()
    push(elems, ast::expr_num(10))
    push(elems, ast::expr_num(20))
    push(elems, ast::expr_num(30))
    let arr = ast::expr_array(elems)
    let e = ast::expr_index(arr, ast::expr_num(1))
    let res = eval::eval_expr(e, eval::env_new, vec<Box<FnDef>>())
    assert::assert_eq_i32(ast::val_to_int(res), 20)
    return 0
}

fn test_option_some() -> i32 {
    let mut args = vec<Box<Expr>>()
    push(args, ast::expr_num(42))
    let e = ast::expr_enum("Option", "Some", args)
    let res = eval::eval_expr(e, eval::env_new, vec<Box<FnDef>>())
    assert::assert_eq_i32(ast::val_to_int(res), 42)
    assert::assert_eq_str(ast::val_to_string(res), "Some(42)")
    return 0
}

fn test_option_none() -> i32 {
    let e = ast::expr_enum("Option", "None", vec<Box<Expr>>())
    let res = eval::eval_expr(e, eval::env_new, vec<Box<FnDef>>())
    assert::assert_eq_str(ast::val_to_string(res), "None")
    assert::assert_true(!ast::val_to_bool(res))
    return 0
}

fn test_result_ok() -> i32 {
    let mut args = vec<Box<Expr>>()
    push(args, ast::expr_num(99))
    let e = ast::expr_enum("Result", "Ok", args)
    let res = eval::eval_expr(e, eval::env_new, vec<Box<FnDef>>())
    assert::assert_eq_i32(ast::val_to_int(res), 99)
    assert::assert_eq_str(ast::val_to_string(res), "Ok(99)")
    return 0
}

fn test_result_err() -> i32 {
    let mut args = vec<Box<Expr>>()
    push(args, ast::expr_str("oops"))
    let e = ast::expr_enum("Result", "Err", args)
    let res = eval::eval_expr(e, eval::env_new, vec<Box<FnDef>>())
    assert::assert_eq_str(ast::val_to_string(res), "Err(oops)")
    assert::assert_true(!ast::val_to_bool(res))
    return 0
}

fn test_try_return() -> i32 {
    let mut ok_args = vec<Box<Expr>>()
    push(ok_args, ast::expr_num(21))
    let ok_try = ast::expr_try(ast::expr_enum("Result", "Ok", ok_args))
    let v1 = eval::eval_expr(ok_try, eval::env_new, vec<Box<FnDef>>())
    assert::assert_eq_i32(ast::val_to_int(v1), 21)
    let mut err_args = vec<Box<Expr>>()
    push(err_args, ast::expr_str("bad"))
    let err_try = ast::expr_try(ast::expr_enum("Result", "Err", err_args))
    let mut fbody = vec<Box<Stmt>>()
    push(fbody, ast::stmt_let("a", err_try))
    push(fbody, ast::stmt_return(ast::expr_num(42)))
    let f = ast::fn_def("f", vec<str>(), fbody)
    let mut fns = vec<Box<FnDef>>()
    push(fns, f)
    let mut mb = vec<Box<Stmt>>()
    push(mb, ast::stmt_return(ast::expr_call("f", vec<Box<Expr>>())))
    let res = eval::eval_program(ast::program_new(fns, mb))
    assert::assert_eq_str(ast::val_to_string(res), "Err(bad)")
    return 0
}

fn selftest() -> i32 {
    test_arithmetic()
    test_variables_and_assign()
    test_conditional_if()
    test_while_loop()
    test_functions_and_recursion()
    test_string_operations()
    test_tuple()
    test_array()
    test_index()
    test_option_some()
    test_option_none()
    test_result_ok()
    test_result_err()
    test_try_return()
    print("hzast selftest passed")
    return 0
}

fn main() -> i32 {
    if arg_count() >= 2 && arg(1) == "--selftest" {
        return selftest()
    }
    if arg_count() >= 2 && arg(1) == "--dump-eval" {
        return dump::dump_eval
    }
    if arg_count() >= 4 && arg(1) == "--dump-json" && arg(2) == "-i" {
        return dump::dump_json_file(arg(3))
    }
    if arg_count() >= 3 && arg(1) == "--dump-json" {
        return dump::dump_json(arg(2))
    }
    // Default to running selftest
    return selftest()
}
