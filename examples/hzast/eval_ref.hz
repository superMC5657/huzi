# C1 原生参照：与 hzast --dump-eval 同 20 行（见 RFC），直写算式不经 eval。
fn fact(n: i32) -> i32 {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}

struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn sum(self: Point) -> i32 {
        return self.x + self.y
    }
}

fn main() -> i32 {
    print(concat("arithmetic=", to_string((3 + 4) * 5 - 10)))
    let mut x = 10
    x = x + 20
    print(concat("variables=", to_string(x * 2)))
    let a = 15
    let mut r = 0
    if a > 10 {
        r = 100
    } else {
        r = 200
    }
    print(concat("conditional=", to_string(r)))
    let mut sum = 0
    let mut i = 1
    while i <= 10 {
        sum = sum + i
        i = i + 1
    }
    print(concat("while=", to_string(sum)))
    print(concat("fact=", to_string(fact(5))))
    print(concat("str=", "hello ", "huzi"))
    print("tuple=(10, 20)")
    print("array=[1, 2, 3]")
    print(concat("index=", to_string(20)))
    print("option_some=Some(42)")
    print("option_none=None")
    print("result_ok=Ok(99)")
    print("result_err=Err(oops)")
    print("result_try=Err(bad)")
    print("struct=Point{x=10, y=20}")
    let pf = Point { x: 10, y: 20 }
    print(concat("field=", to_string(pf.x)))
    print(concat("method=", to_string(pf.sum())))
    let name = "Alice"
    print(concat("fstring=", f"hi {name}!"))
    print("type_atom={\"kind\":\"type\",\"name\":\"i32\",\"args\":[]}")
    print("type_applied={\"kind\":\"type\",\"name\":\"Pair\",\"args\":[{\"kind\":\"type\",\"name\":\"i32\",\"args\":[]},{\"kind\":\"type\",\"name\":\"str\",\"args\":[]}]}")
    return 0
}
