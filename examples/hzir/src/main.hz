// hzir text IR emitter
// Huzi builds LLVM IR text with concat only
// write with write_file, build with clang via process_run
// range: i32 arithmetic fn let while if print plus str glue
import jlower
import jlower_cases

fn hz_prefix() -> str {
    if read_file_ok("huzc/test/cases/01_variables_ops.hz") {
        return "examples/hzir/"
    } elif read_file_ok("cases/s1_hello.hz") {
        return ""
    } else {
        return "../../"
    }
}

fn to_win_path(p: str) -> str {
    let n = len(p)
    let mut res = ""
    let mut i = 0
    while i < n {
        let ch = substring(p, i, i + 1)
        if ch == "/" {
            res = concat(res, "\\")
        } else {
            res = concat(res, ch)
        }
        i = i + 1
    }
    return res
}

fn ensure_target(prefix: str) -> i32 {
    let d = concat(prefix, "target")
    let cmd = concat("mkdir ", d)
    let r = process_run(cmd)
    let code = r.0
    if code == 0 {
        print("mkdir ok")
        return 0
    }
    let w = to_win_path(d)
    let cmd2 = concat("mkdir ", w)
    let r2 = process_run(cmd2)
    if r2.0 == 0 {
        print("mkdir ok")
    } else {
        print("mkdir skip")
    }
    return 0
}

fn emit_s1() -> str {
    let mut ir = "declare i32 @printf(ptr, ...)\n"
    ir = concat(ir, "@.fmt.s = private constant [4 x i8] c\"%s\\0A\\00\"\n")
    ir = concat(ir, "@.str.hello = private constant [11 x i8] c\"hello hzir\\00\"\n")
    ir = concat(ir, "define i32 @main() {\n")
    ir = concat(ir, "entry:\n")
    ir = concat(ir, "  %fmt = getelementptr [4 x i8], ptr @.fmt.s, i32 0, i32 0\n")
    ir = concat(ir, "  %str = getelementptr [11 x i8], ptr @.str.hello, i32 0, i32 0\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, ptr %str)\n")
    ir = concat(ir, "  ret i32 0\n")
    ir = concat(ir, "}\n")
    return ir
}

fn emit_s2() -> str {
    let mut ir = "declare i32 @printf(ptr, ...)\n"
    ir = concat(ir, "@.fmt.d = private constant [4 x i8] c\"%d\\0A\\00\"\n")
    ir = concat(ir, "define i32 @main() {\n")
    ir = concat(ir, "entry:\n")
    ir = concat(ir, "  %fmt = getelementptr [4 x i8], ptr @.fmt.d, i32 0, i32 0\n")
    ir = concat(ir, "  %t0 = mul i32 4, 2\n")
    ir = concat(ir, "  %t1 = add i32 3, %t0\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %t1)\n")
    ir = concat(ir, "  %t2 = add i32 3, 4\n")
    ir = concat(ir, "  %t3 = mul i32 %t2, 2\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %t3)\n")
    ir = concat(ir, "  %t4 = sdiv i32 6, 2\n")
    ir = concat(ir, "  %t5 = sub i32 10, %t4\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %t5)\n")
    ir = concat(ir, "  %t6 = srem i32 10, 3\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %t6)\n")
    ir = concat(ir, "  ret i32 0\n")
    ir = concat(ir, "}\n")
    return ir
}

fn emit_s3() -> str {
    let mut ir = "declare i32 @printf(ptr, ...)\n"
    ir = concat(ir, "@.fmt.d = private constant [4 x i8] c\"%d\\0A\\00\"\n")
    ir = concat(ir, "define i32 @main() {\n")
    ir = concat(ir, "entry:\n")
    ir = concat(ir, "  %fmt = getelementptr [4 x i8], ptr @.fmt.d, i32 0, i32 0\n")
    ir = concat(ir, "  %x = alloca i32\n")
    ir = concat(ir, "  store i32 10, ptr %x\n")
    ir = concat(ir, "  %v0 = load i32, ptr %x\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %v0)\n")
    ir = concat(ir, "  %x1 = alloca i32\n")
    ir = concat(ir, "  store i32 20, ptr %x1\n")
    ir = concat(ir, "  %v1 = load i32, ptr %x1\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %v1)\n")
    ir = concat(ir, "  %y = alloca i32\n")
    ir = concat(ir, "  store i32 1, ptr %y\n")
    ir = concat(ir, "  %vy0 = load i32, ptr %y\n")
    ir = concat(ir, "  %vy1 = add i32 %vy0, 10\n")
    ir = concat(ir, "  store i32 %vy1, ptr %y\n")
    ir = concat(ir, "  %v2 = load i32, ptr %y\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %v2)\n")
    ir = concat(ir, "  ret i32 0\n")
    ir = concat(ir, "}\n")
    return ir
}

fn emit_s4() -> str {
    let mut ir = "declare i32 @printf(ptr, ...)\n"
    ir = concat(ir, "@.fmt.d = private constant [4 x i8] c\"%d\\0A\\00\"\n")
    ir = concat(ir, "define i32 @max(i32 %a, i32 %b) {\n")
    ir = concat(ir, "entry:\n")
    ir = concat(ir, "  %cmp = icmp sgt i32 %a, %b\n")
    ir = concat(ir, "  br i1 %cmp, label %then, label %else\n")
    ir = concat(ir, "then:\n")
    ir = concat(ir, "  ret i32 %a\n")
    ir = concat(ir, "else:\n")
    ir = concat(ir, "  ret i32 %b\n")
    ir = concat(ir, "}\n")
    ir = concat(ir, "define i32 @main() {\n")
    ir = concat(ir, "entry:\n")
    ir = concat(ir, "  %fmt = getelementptr [4 x i8], ptr @.fmt.d, i32 0, i32 0\n")
    ir = concat(ir, "  %c0 = call i32 @max(i32 10, i32 20)\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %c0)\n")
    ir = concat(ir, "  %c1 = call i32 @max(i32 50, i32 30)\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %c1)\n")
    ir = concat(ir, "  %c2 = call i32 @max(i32 7, i32 7)\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %c2)\n")
    ir = concat(ir, "  ret i32 0\n")
    ir = concat(ir, "}\n")
    return ir
}

fn emit_s5() -> str {
    let mut ir = "declare i32 @printf(ptr, ...)\n"
    ir = concat(ir, "@.fmt.d = private constant [4 x i8] c\"%d\\0A\\00\"\n")
    ir = concat(ir, "define i32 @main() {\n")
    ir = concat(ir, "entry:\n")
    ir = concat(ir, "  %fmt = getelementptr [4 x i8], ptr @.fmt.d, i32 0, i32 0\n")
    ir = concat(ir, "  %sum = alloca i32\n")
    ir = concat(ir, "  store i32 0, ptr %sum\n")
    ir = concat(ir, "  %i = alloca i32\n")
    ir = concat(ir, "  store i32 1, ptr %i\n")
    ir = concat(ir, "  br label %loop.cond\n")
    ir = concat(ir, "loop.cond:\n")
    ir = concat(ir, "  %iv = load i32, ptr %i\n")
    ir = concat(ir, "  %cmp = icmp sle i32 %iv, 10\n")
    ir = concat(ir, "  br i1 %cmp, label %loop.body, label %loop.end\n")
    ir = concat(ir, "loop.body:\n")
    ir = concat(ir, "  %sv = load i32, ptr %sum\n")
    ir = concat(ir, "  %iv2 = load i32, ptr %i\n")
    ir = concat(ir, "  %ns = add i32 %sv, %iv2\n")
    ir = concat(ir, "  store i32 %ns, ptr %sum\n")
    ir = concat(ir, "  %iv3 = load i32, ptr %i\n")
    ir = concat(ir, "  %ni = add i32 %iv3, 1\n")
    ir = concat(ir, "  store i32 %ni, ptr %i\n")
    ir = concat(ir, "  br label %loop.cond\n")
    ir = concat(ir, "loop.end:\n")
    ir = concat(ir, "  %res = load i32, ptr %sum\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %res)\n")
    ir = concat(ir, "  ret i32 0\n")
    ir = concat(ir, "}\n")
    return ir
}

fn emit_s6() -> str {
    let mut ir = "declare i32 @printf(ptr, ...)\n"
    ir = concat(ir, "@.fmt.d = private constant [4 x i8] c\"%d\\0A\\00\"\n")
    ir = concat(ir, "define i32 @main() {\n")
    ir = concat(ir, "entry:\n")
    ir = concat(ir, "  %fmt = getelementptr [4 x i8], ptr @.fmt.d, i32 0, i32 0\n")
    ir = concat(ir, "  %n = alloca i32\n")
    ir = concat(ir, "  store i32 5, ptr %n\n")
    ir = concat(ir, "  %acc = alloca i32\n")
    ir = concat(ir, "  store i32 1, ptr %acc\n")
    ir = concat(ir, "  br label %loop.cond\n")
    ir = concat(ir, "loop.cond:\n")
    ir = concat(ir, "  %nv = load i32, ptr %n\n")
    ir = concat(ir, "  %cmp = icmp sgt i32 %nv, 1\n")
    ir = concat(ir, "  br i1 %cmp, label %loop.body, label %loop.end\n")
    ir = concat(ir, "loop.body:\n")
    ir = concat(ir, "  %av = load i32, ptr %acc\n")
    ir = concat(ir, "  %nv2 = load i32, ptr %n\n")
    ir = concat(ir, "  %na = mul i32 %av, %nv2\n")
    ir = concat(ir, "  store i32 %na, ptr %acc\n")
    ir = concat(ir, "  %nv3 = load i32, ptr %n\n")
    ir = concat(ir, "  %nn = sub i32 %nv3, 1\n")
    ir = concat(ir, "  store i32 %nn, ptr %n\n")
    ir = concat(ir, "  br label %loop.cond\n")
    ir = concat(ir, "loop.end:\n")
    ir = concat(ir, "  %res = load i32, ptr %acc\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %res)\n")
    ir = concat(ir, "  ret i32 0\n")
    ir = concat(ir, "}\n")
    return ir
}

fn emit_s7() -> str {
    let mut ir = "declare i32 @printf(ptr, ...)\n"
    ir = concat(ir, "@.fmt.d = private constant [4 x i8] c\"%d\\0A\\00\"\n")
    ir = concat(ir, "define i32 @add(i32 %a, i32 %b) {\n")
    ir = concat(ir, "entry:\n")
    ir = concat(ir, "  %r = add i32 %a, %b\n")
    ir = concat(ir, "  ret i32 %r\n")
    ir = concat(ir, "}\n")
    ir = concat(ir, "define i32 @mul(i32 %a, i32 %b) {\n")
    ir = concat(ir, "entry:\n")
    ir = concat(ir, "  %r = mul i32 %a, %b\n")
    ir = concat(ir, "  ret i32 %r\n")
    ir = concat(ir, "}\n")
    ir = concat(ir, "define i32 @add_mul(i32 %a, i32 %b, i32 %c) {\n")
    ir = concat(ir, "entry:\n")
    ir = concat(ir, "  %m = call i32 @mul(i32 %a, i32 %b)\n")
    ir = concat(ir, "  %r = call i32 @add(i32 %m, i32 %c)\n")
    ir = concat(ir, "  ret i32 %r\n")
    ir = concat(ir, "}\n")
    ir = concat(ir, "define i32 @main() {\n")
    ir = concat(ir, "entry:\n")
    ir = concat(ir, "  %fmt = getelementptr [4 x i8], ptr @.fmt.d, i32 0, i32 0\n")
    ir = concat(ir, "  %c0 = call i32 @add(i32 3, i32 4)\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %c0)\n")
    ir = concat(ir, "  %c1 = call i32 @mul(i32 3, i32 4)\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %c1)\n")
    ir = concat(ir, "  %c2 = call i32 @add_mul(i32 3, i32 4, i32 5)\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %c2)\n")
    ir = concat(ir, "  ret i32 0\n")
    ir = concat(ir, "}\n")
    return ir
}

fn emit_s8() -> str {
    let mut ir = "declare i32 @printf(ptr, ...)\n"
    ir = concat(ir, "@.fmt.d = private constant [4 x i8] c\"%d\\0A\\00\"\n")
    ir = concat(ir, "define i32 @fib(i32 %n) {\n")
    ir = concat(ir, "entry:\n")
    ir = concat(ir, "  %cmp = icmp sle i32 %n, 1\n")
    ir = concat(ir, "  br i1 %cmp, label %early, label %setup\n")
    ir = concat(ir, "early:\n")
    ir = concat(ir, "  ret i32 %n\n")
    ir = concat(ir, "setup:\n")
    ir = concat(ir, "  %a = alloca i32\n")
    ir = concat(ir, "  store i32 0, ptr %a\n")
    ir = concat(ir, "  %b = alloca i32\n")
    ir = concat(ir, "  store i32 1, ptr %b\n")
    ir = concat(ir, "  %i = alloca i32\n")
    ir = concat(ir, "  store i32 2, ptr %i\n")
    ir = concat(ir, "  br label %loop.cond\n")
    ir = concat(ir, "loop.cond:\n")
    ir = concat(ir, "  %iv = load i32, ptr %i\n")
    ir = concat(ir, "  %cc = icmp sle i32 %iv, %n\n")
    ir = concat(ir, "  br i1 %cc, label %loop.body, label %loop.end\n")
    ir = concat(ir, "loop.body:\n")
    ir = concat(ir, "  %av = load i32, ptr %a\n")
    ir = concat(ir, "  %bv = load i32, ptr %b\n")
    ir = concat(ir, "  %t = add i32 %av, %bv\n")
    ir = concat(ir, "  %bv2 = load i32, ptr %b\n")
    ir = concat(ir, "  store i32 %bv2, ptr %a\n")
    ir = concat(ir, "  store i32 %t, ptr %b\n")
    ir = concat(ir, "  %iv2 = load i32, ptr %i\n")
    ir = concat(ir, "  %ni = add i32 %iv2, 1\n")
    ir = concat(ir, "  store i32 %ni, ptr %i\n")
    ir = concat(ir, "  br label %loop.cond\n")
    ir = concat(ir, "loop.end:\n")
    ir = concat(ir, "  %res = load i32, ptr %b\n")
    ir = concat(ir, "  ret i32 %res\n")
    ir = concat(ir, "}\n")
    ir = concat(ir, "define i32 @main() {\n")
    ir = concat(ir, "entry:\n")
    ir = concat(ir, "  %fmt = getelementptr [4 x i8], ptr @.fmt.d, i32 0, i32 0\n")
    ir = concat(ir, "  %c0 = call i32 @fib(i32 0)\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %c0)\n")
    ir = concat(ir, "  %c1 = call i32 @fib(i32 1)\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %c1)\n")
    ir = concat(ir, "  %c2 = call i32 @fib(i32 10)\n")
    ir = concat(ir, "  call i32 (ptr, ...) @printf(ptr %fmt, i32 %c2)\n")
    ir = concat(ir, "  ret i32 0\n")
    ir = concat(ir, "}\n")
    return ir
}

fn check_one(name: str, ir: str, ll: str, exe: str, want: str) -> i32 {
    let ok = write_file(ll, ir)
    if ok {
        print("wrote ", name)
    } else {
        print("write fail ", name)
        return 1
    }
    let c1 = concat("clang ", ll)
    let c2 = concat(c1, " -o ")
    let cmd = concat(c2, exe)
    let br = process_run(cmd)
    let code = br.0
    let clog = br.1
    if code != 0 {
        print("clang fail ", name)
        print(trim(clog))
        return 1
    }
    let rr = process_run(exe)
    let rc = rr.0
    let oo = trim(rr.1)
    if rc == 0 {
        if oo == want {
            print("pass ", name)
            return 0
        } else {
            print("diff ", name)
            print(oo)
            print(want)
            return 1
        }
    }
    let wexe = to_win_path(exe)
    let rr2 = process_run(wexe)
    let rc2 = rr2.0
    let oo2 = trim(rr2.1)
    if rc2 != 0 {
        print("run fail ", name)
        return 1
    }
    if oo2 == want {
        print("pass ", name)
        return 0
    } else {
        print("diff ", name)
        print(oo2)
        print(want)
        return 1
    }
}

fn run_case(prefix: str, n: i32) -> i32 {
    let base = concat(prefix, "target/hzir_s")
    if n == 1 {
        let ir = emit_s1()
        let ll = concat(concat(base, "1"), ".ll")
        let exe = concat(concat(base, "1"), ".exe")
        return check_one("s1 hello", ir, ll, exe, "hello hzir")
    } elif n == 2 {
        let ir = emit_s2()
        let ll = concat(concat(base, "2"), ".ll")
        let exe = concat(concat(base, "2"), ".exe")
        return check_one("s2 arith", ir, ll, exe, "11\n14\n7\n1")
    } elif n == 3 {
        let ir = emit_s3()
        let ll = concat(concat(base, "3"), ".ll")
        let exe = concat(concat(base, "3"), ".exe")
        return check_one("s3 shadow", ir, ll, exe, "10\n20\n11")
    } elif n == 4 {
        let ir = emit_s4()
        let ll = concat(concat(base, "4"), ".ll")
        let exe = concat(concat(base, "4"), ".exe")
        return check_one("s4 max", ir, ll, exe, "20\n50\n7")
    } elif n == 5 {
        let ir = emit_s5()
        let ll = concat(concat(base, "5"), ".ll")
        let exe = concat(concat(base, "5"), ".exe")
        return check_one("s5 sum", ir, ll, exe, "55")
    } elif n == 6 {
        let ir = emit_s6()
        let ll = concat(concat(base, "6"), ".ll")
        let exe = concat(concat(base, "6"), ".exe")
        return check_one("s6 fact", ir, ll, exe, "120")
    } elif n == 7 {
        let ir = emit_s7()
        let ll = concat(concat(base, "7"), ".ll")
        let exe = concat(concat(base, "7"), ".exe")
        return check_one("s7 call", ir, ll, exe, "7\n12\n17")
    } elif n == 8 {
        let ir = emit_s8()
        let ll = concat(concat(base, "8"), ".ll")
        let exe = concat(concat(base, "8"), ".exe")
        return check_one("s8 fib", ir, ll, exe, "0\n1\n55")
    } else {
        print("bad n ", n)
        return 1
    }
}

fn run_json_case(prefix: str, n: i32) -> i32 {
    let jbase = concat(prefix, "json/s")
    let tbase = concat(prefix, "target/hzir_s")
    if n == 1 {
        let jp = concat(concat(jbase, "1_hello"), ".json")
        if !read_file_ok(jp) {
            print("missing json s1")
            return 1
        }
        let js = read_file(jp)
        let ir = jlower_cases::lower_s1_json(js)
        if ir == "" {
            print("lower fail s1-json")
            return 1
        }
        let ll = concat(concat(tbase, "1j"), ".ll")
        let exe = concat(concat(tbase, "1j"), ".exe")
        return check_one("s1-json hello", ir, ll, exe, "hello hzir")
    } elif n == 2 {
        let jp = concat(concat(jbase, "2_arith"), ".json")
        if !read_file_ok(jp) {
            print("missing json s2")
            return 1
        }
        let js = read_file(jp)
        let ir = jlower_cases::lower_s2_json(js)
        if ir == "" {
            print("lower fail s2-json")
            return 1
        }
        let ll = concat(concat(tbase, "2j"), ".ll")
        let exe = concat(concat(tbase, "2j"), ".exe")
        return check_one("s2-json arith", ir, ll, exe, "11\n14\n7\n1")
    } elif n == 5 {
        let jp = concat(concat(jbase, "5_sum"), ".json")
        if !read_file_ok(jp) {
            print("missing json s5")
            return 1
        }
        let js = read_file(jp)
        let ir = jlower_cases::lower_s5_json(js)
        if ir == "" {
            print("lower fail s5-json")
            return 1
        }
        let ll = concat(concat(tbase, "5j"), ".ll")
        let exe = concat(concat(tbase, "5j"), ".exe")
        return check_one("s5-json sum", ir, ll, exe, "55")
    } else {
        print("bad json n ", n)
        return 1
    }
}

fn run_json_all(prefix: str) -> i32 {
    let mut fails = 0
    let r1 = run_json_case(prefix, 1)
    if r1 != 0 {
        fails = fails + 1
    }
    let r2 = run_json_case(prefix, 2)
    if r2 != 0 {
        fails = fails + 1
    }
    let r5 = run_json_case(prefix, 5)
    if r5 != 0 {
        fails = fails + 1
    }
    return fails
}

fn main() -> i32 {
    let prefix = hz_prefix()
    let mk = ensure_target(prefix)
    if mk != 0 {
        print("mkdir note")
    }
    let mut n = 1
    let mut fails = 0
    while n <= 8 {
        let rc = run_case(prefix, n)
        if rc != 0 {
            fails = fails + 1
        }
        n = n + 1
    }
    let jf = run_json_all(prefix)
    fails = fails + jf
    print("fails: ", fails)
    if fails == 0 {
        print("hzir all 8 pass")
        print("hzir json 3 pass")
        return 0
    } else {
        print("hzir fail")
        return 1
    }
}
