# hzparse 语料清单:自解析验收的全部文件(仓库根相对路径)。
# root 为 ""(二进制在仓库根运行)或 "../../"(在 examples/hzparse 内运行)。
fn with_root(root: str, p: str) -> str {
    if root == "" {
        return p
    }
    return concat(root, p)
}

fn corpus_min() -> i32 {
    return 90
}

fn corpus_files(root: str) -> vec<str> {
    let mut out = vec<str>()
