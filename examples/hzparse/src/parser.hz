# hzparse —— 用 Huzi 写的 Huzi 语法分析器子集(自举演示之二)。
#
# 输入复用 hzlex 的平行数组词法约定 (kinds/texts);输出顶层结构计数
# (stats) 与错误表 (errs)。对标 huzc/crates/huzi-parser 的递归下降形状,
# 冻结边界见 ../RFC.md:只验结构,不做 match 穷尽 / 泛型求解 / 上下文检查。
#
# 实现要点:游标 pos / 深度 dep / 最大深度 maxd 均为单元素 vec<i32>
# 可变单元(句柄语义,调用间共享),天然支持 save/restore 回溯,顺手消解
# `<` 在泛型实参 `<T>` 与比较 `a < b` 之间的二义。
#
# stats 下标:0 fn,1 struct,2 enum,3 trait,4 impl,5 import,6 export,7 let,
# 8 最大表达式嵌套深度。
import parser.cursor
import parser.stmt

# ---- 入口 ----
# 解析 kinds/texts 全串;返回 (ok, stats, errs)。
fn parse(kinds: vec<str>, texts: vec<str>) -> (bool, vec<i32>, vec<str>) {
    let mut stats = vec(0, 0, 0, 0, 0, 0, 0, 0, 0)
    let mut errs = vec<str>()
    let mut pos = vec(0)
    let mut dep = vec(0)
    let mut maxd = vec(0)
    let n = len(kinds)
    let mut ok = true
    while pos[0] < n && ok {
        if cursor::pz_at_kind(kinds, pos, "eof") {
            break
        }
        if !stmt::pz_stmt(kinds, texts, pos, errs, stats, dep, maxd) {
            ok = false
        }
    }
    stats[8] = maxd[0]
    return (ok, stats, errs)
}

fn summarize(stats: vec<i32>) -> str {
    return concat("fns=", to_string(stats[0]), " structs=", to_string(stats[1]), " enums=", to_string(stats[2]), " traits=", to_string(stats[3]), " impls=", to_string(stats[4]), " imports=", to_string(stats[5]), " exports=", to_string(stats[6]), " lets=", to_string(stats[7]), " depth=", to_string(stats[8]))
}
