# parser/atom —— 原子表达式入口(闭包/主分发/起始集)，依赖 cursor/typ/expr/stmt/atom_ident/atom_branch。
# 由原 parser/atom.hz 拆分：标识组搬至 atom_ident.hz，分支组搬至 atom_branch.hz；
# 本文件仅保留 Pz_closure/Pz_primary/Pz_expr_start(纯搬移，分发目标改为 qualified 调用)。
import cursor
import typ
import expr
import stmt
import atom_ident
import atom_branch

# 闭包表达式: `|| expr`、`|x| expr` 或 `|x, y: i32| -> i32 { ... }`
fn pz_closure(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if cursor::pz_at(kinds, texts, pos, "||") {
        cursor::pz_next(pos)
    } elif cursor::pz_at(kinds, texts, pos, "|") {
        cursor::pz_next(pos)
        while !cursor::pz_at(kinds, texts, pos, "|") && !cursor::pz_eof(kinds, pos) {
            if !cursor::pz_is_ident(kinds, texts, pos) {
                return cursor::pz_fail(errs, texts, pos, lines, cols, "expected parameter name in closure")
            }
            cursor::pz_next(pos)
            if cursor::pz_at(kinds, texts, pos, ":") {
                cursor::pz_next(pos)
                if !typ::pz_type(kinds, texts, pos, errs, lines, cols) {
                    return false
                }
            }
            if cursor::pz_at(kinds, texts, pos, ",") {
                cursor::pz_next(pos)
            } else {
                break
            }
        }
        if !cursor::pz_at(kinds, texts, pos, "|") {
            return cursor::pz_fail(errs, texts, pos, lines, cols, "expected '|' after closure parameters")
        }
        cursor::pz_next(pos)
    } else {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected closure")
    }
    if cursor::pz_at(kinds, texts, pos, "->") {
        cursor::pz_next(pos)
        if !typ::pz_type(kinds, texts, pos, errs, lines, cols) {
            return false
        }
    }
    if cursor::pz_at(kinds, texts, pos, "{") {
        return stmt::pz_block(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    return expr::pz_expr(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
}

fn pz_primary(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if cursor::pz_at_kind(kinds, pos, "int") || cursor::pz_at_kind(kinds, pos, "float") || cursor::pz_at_kind(kinds, pos, "string") || cursor::pz_at_kind(kinds, pos, "char") {
        cursor::pz_next(pos)
        return true
    }
    if cursor::pz_kw(kinds, texts, pos, "true") || cursor::pz_kw(kinds, texts, pos, "false") {
        cursor::pz_next(pos)
        return true
    }
    if cursor::pz_kw(kinds, texts, pos, "if") {
        return atom_branch::pz_if_expr(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    if cursor::pz_kw(kinds, texts, pos, "match") {
        return atom_branch::pz_match_expr(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    if cursor::pz_at(kinds, texts, pos, "||") || cursor::pz_at(kinds, texts, pos, "|") {
        return pz_closure(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    if cursor::pz_is_ident(kinds, texts, pos) {
        return atom_ident::pz_ident_expr(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    if cursor::pz_at(kinds, texts, pos, "(") {
        cursor::pz_next(pos)
        if !expr::pz_expr(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
            return false
        }
        while cursor::pz_at(kinds, texts, pos, ",") {
            cursor::pz_next(pos)
            if !expr::pz_expr(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
                return false
            }
        }
        if !cursor::pz_at(kinds, texts, pos, ")") {
            return cursor::pz_fail(errs, texts, pos, lines, cols, "expected ')' in tuple")
        }
        cursor::pz_next(pos)
        return true
    }
    if cursor::pz_at(kinds, texts, pos, "[") {
        cursor::pz_next(pos)
        if cursor::pz_at(kinds, texts, pos, "]") {
            cursor::pz_next(pos)
            return true
        }
        if !expr::pz_expr(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
            return false
        }
        while cursor::pz_at(kinds, texts, pos, ",") {
            cursor::pz_next(pos)
            if cursor::pz_at(kinds, texts, pos, "]") {
                break
            }
            if !expr::pz_expr(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
                return false
            }
        }
        if !cursor::pz_at(kinds, texts, pos, "]") {
            return cursor::pz_fail(errs, texts, pos, lines, cols, "expected ']' in array literal")
        }
        cursor::pz_next(pos)
        return true
    }
    return cursor::pz_fail(errs, texts, pos, lines, cols, "unexpected token in expression")
}

# 表达式起始集合(return 后可选值的判据)。
fn pz_expr_start(kinds: vec<str>, texts: vec<str>, pos: vec<i32>) -> bool {
    if cursor::pz_at_kind(kinds, pos, "int") || cursor::pz_at_kind(kinds, pos, "float") || cursor::pz_at_kind(kinds, pos, "string") || cursor::pz_at_kind(kinds, pos, "char") {
        return true
    }
    if cursor::pz_is_ident(kinds, texts, pos) {
        return true
    }
    if cursor::pz_kw(kinds, texts, pos, "if") || cursor::pz_kw(kinds, texts, pos, "match") || cursor::pz_kw(kinds, texts, pos, "true") || cursor::pz_kw(kinds, texts, pos, "false") {
        return true
    }
    if cursor::pz_at(kinds, texts, pos, "||") || cursor::pz_at(kinds, texts, pos, "|") {
        return true
    }
    return cursor::pz_at(kinds, texts, pos, "!") || cursor::pz_at(kinds, texts, pos, "-") || cursor::pz_at(kinds, texts, pos, "*") || cursor::pz_at(kinds, texts, pos, "(") || cursor::pz_at(kinds, texts, pos, "[")
}
