# parser/p1expr —— P1 子集表达式 + P3 复合值 + P3b 结构 + P3c match/closure（JSON 直出）。
# 链：or → and → eq → cmp → add → mul → unary → suffix → atom；后缀转调 p1p3b，原子转调 p1p3c。
import cursor
import typ
import p1json
import p1p3b
import p1p3c

fn p1_bin(op: str, left: str, right: str) -> str {
    return concat("{\"kind\":\"bin\",\"op\":", p1json::p1_quoted(op), ",\"left\":", left, ",\"right\":", right, "}")
}

fn p1_un(op: str, operand: str) -> str {
    return concat("{\"kind\":\"un\",\"op\":", p1json::p1_quoted(op), ",\"operand\":", operand, "}")
}

fn p1_is_comp_enum(name: str) -> bool {
    if name == "Option" {
        return true
    }
    if name == "Result" {
        return true
    }
    return false
}

fn p1_is_comp_variant(v: str) -> bool {
    if v == "Some" {
        return true
    }
    if v == "None" {
        return true
    }
    if v == "Ok" {
        return true
    }
    if v == "Err" {
        return true
    }
    return false
}

# `<T>(...)` / `<T>{...}` / `<T>::...` 试探：完整匹配即泛型形状（超集，调用方直接失败）。
fn p1_is_generic(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if !cursor::pz_next_at(kinds, texts, pos, 1, "<") {
        return false
    }
    let saved = pos[0]
    let mark = cursor::pz_mark(errs)
    cursor::pz_next(pos)
    cursor::pz_next(pos)
    let mut ok = typ::pz_type(kinds, texts, pos, errs, lines, cols)
    while ok && cursor::pz_at(kinds, texts, pos, ",") {
        cursor::pz_next(pos)
        ok = typ::pz_type(kinds, texts, pos, errs, lines, cols)
    }
    let mut is_gen = false
    if ok && cursor::pz_at(kinds, texts, pos, ">") {
        cursor::pz_next(pos)
        if cursor::pz_at(kinds, texts, pos, "(") {
            is_gen = true
        } elif cursor::pz_at(kinds, texts, pos, "{") {
            is_gen = true
        } elif cursor::pz_at(kinds, texts, pos, "::") {
            is_gen = true
        }
    }
    pos[0] = saved
    cursor::pz_rollback(errs, mark)
    return is_gen
}

# 后缀链已迁 p1p3b::p1_postfix（P3b 点号/方法扩展，纯搬移见 p1p3b.hz）。
# `Enum::Variant` / `Enum::Variant(args)`：仅 Option/Result × Some/None/Ok/Err，无泛型实参。
fn p1_enum_after(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, enum_name: str, lines: vec<i32>, cols: vec<i32>) -> (bool, str) {
    cursor::pz_next(pos)
    cursor::pz_next(pos)
    if !cursor::pz_is_ident(kinds, texts, pos) {
        return (false, "")
    }
    let variant = texts[pos[0]]
    if !p1_is_comp_variant(variant) {
        return (false, "")
    }
    cursor::pz_next(pos)
    let full = concat(enum_name, "::", variant)
    if cursor::pz_at(kinds, texts, pos, "(") {
        cursor::pz_next(pos)
        let mut args = vec<str>()
        if cursor::pz_at(kinds, texts, pos, ")") {
            cursor::pz_next(pos)
            return p1p3b::p1_postfix(kinds, texts, pos, errs, p1json::p1_enum_json(full, args), lines, cols)
        }
        let a0 = p1_expr(kinds, texts, pos, errs, lines, cols)
        if !a0.0 {
            return a0
        }
        push(args, a0.1)
        while cursor::pz_at(kinds, texts, pos, ",") {
            cursor::pz_next(pos)
            if cursor::pz_at(kinds, texts, pos, ")") {
                break
            }
            let a = p1_expr(kinds, texts, pos, errs, lines, cols)
            if !a.0 {
                return a
            }
            push(args, a.1)
        }
        if !cursor::pz_at(kinds, texts, pos, ")") {
            return (false, "")
        }
        cursor::pz_next(pos)
        return p1p3b::p1_postfix(kinds, texts, pos, errs, p1json::p1_enum_json(full, args), lines, cols)
    }
    let mut empty = vec<str>()
    return p1p3b::p1_postfix(kinds, texts, pos, errs, p1json::p1_enum_json(full, empty), lines, cols)
}

fn p1_expr(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, lines: vec<i32>, cols: vec<i32>) -> (bool, str) {
    return p1_or(kinds, texts, pos, errs, lines, cols)
}

fn p1_or(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, lines: vec<i32>, cols: vec<i32>) -> (bool, str) {
    let l = p1_and(kinds, texts, pos, errs, lines, cols)
    if !l.0 {
        return l
    }
    let mut cur = l.1
    while cursor::pz_at(kinds, texts, pos, "||") {
        cursor::pz_next(pos)
        let r = p1_and(kinds, texts, pos, errs, lines, cols)
        if !r.0 {
            return (false, "")
        }
        cur = p1_bin("||", cur, r.1)
    }
    return (true, cur)
}

fn p1_and(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, lines: vec<i32>, cols: vec<i32>) -> (bool, str) {
    let l = p1_eq(kinds, texts, pos, errs, lines, cols)
    if !l.0 {
        return l
    }
    let mut cur = l.1
    while cursor::pz_at(kinds, texts, pos, "&&") {
        cursor::pz_next(pos)
        let r = p1_eq(kinds, texts, pos, errs, lines, cols)
        if !r.0 {
            return (false, "")
        }
        cur = p1_bin("&&", cur, r.1)
    }
    return (true, cur)
}

fn p1_eq(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, lines: vec<i32>, cols: vec<i32>) -> (bool, str) {
    let l = p1_cmp(kinds, texts, pos, errs, lines, cols)
    if !l.0 {
        return l
    }
    let mut cur = l.1
    while cursor::pz_at(kinds, texts, pos, "==") || cursor::pz_at(kinds, texts, pos, "!=") {
        let mut op = "=="
        if cursor::pz_at(kinds, texts, pos, "!=") {
            op = "!="
        }
        cursor::pz_next(pos)
        let r = p1_cmp(kinds, texts, pos, errs, lines, cols)
        if !r.0 {
            return (false, "")
        }
        cur = p1_bin(op, cur, r.1)
    }
    return (true, cur)
}

fn p1_cmp(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, lines: vec<i32>, cols: vec<i32>) -> (bool, str) {
    let l = p1_add(kinds, texts, pos, errs, lines, cols)
    if !l.0 {
        return l
    }
    let mut cur = l.1
    while cursor::pz_at(kinds, texts, pos, "<") || cursor::pz_at(kinds, texts, pos, "<=") || cursor::pz_at(kinds, texts, pos, ">") || cursor::pz_at(kinds, texts, pos, ">=") {
        let mut op = "<"
        if cursor::pz_at(kinds, texts, pos, "<=") {
            op = "<="
        } elif cursor::pz_at(kinds, texts, pos, ">") {
            op = ">"
        } elif cursor::pz_at(kinds, texts, pos, ">=") {
            op = ">="
        }
        # `<` 须先排除泛型形状（调用方已在 suffix 排除，此处仅保底）。
        cursor::pz_next(pos)
        let r = p1_add(kinds, texts, pos, errs, lines, cols)
        if !r.0 {
            return (false, "")
        }
        cur = p1_bin(op, cur, r.1)
    }
    return (true, cur)
}

fn p1_add(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, lines: vec<i32>, cols: vec<i32>) -> (bool, str) {
    let l = p1_mul(kinds, texts, pos, errs, lines, cols)
    if !l.0 {
        return l
    }
    let mut cur = l.1
    while cursor::pz_at(kinds, texts, pos, "+") || cursor::pz_at(kinds, texts, pos, "-") {
        let mut op = "+"
        if cursor::pz_at(kinds, texts, pos, "-") {
            op = "-"
        }
        cursor::pz_next(pos)
        let r = p1_mul(kinds, texts, pos, errs, lines, cols)
        if !r.0 {
            return (false, "")
        }
        cur = p1_bin(op, cur, r.1)
    }
    return (true, cur)
}

fn p1_mul(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, lines: vec<i32>, cols: vec<i32>) -> (bool, str) {
    let l = p1_unary(kinds, texts, pos, errs, lines, cols)
    if !l.0 {
        return l
    }
    let mut cur = l.1
    while cursor::pz_at(kinds, texts, pos, "*") || cursor::pz_at(kinds, texts, pos, "/") || cursor::pz_at(kinds, texts, pos, "%") {
        let mut op = "*"
        if cursor::pz_at(kinds, texts, pos, "/") {
            op = "/"
        } elif cursor::pz_at(kinds, texts, pos, "%") {
            op = "%"
        }
        cursor::pz_next(pos)
        let r = p1_unary(kinds, texts, pos, errs, lines, cols)
        if !r.0 {
            return (false, "")
        }
        cur = p1_bin(op, cur, r.1)
    }
    return (true, cur)
}

fn p1_unary(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, lines: vec<i32>, cols: vec<i32>) -> (bool, str) {
    if cursor::pz_at(kinds, texts, pos, "!") {
        cursor::pz_next(pos)
        let r = p1_unary(kinds, texts, pos, errs, lines, cols)
        if !r.0 {
            return r
        }
        return (true, p1_un("!", r.1))
    }
    if cursor::pz_at(kinds, texts, pos, "-") {
        cursor::pz_next(pos)
        let r = p1_unary(kinds, texts, pos, errs, lines, cols)
        if !r.0 {
            return r
        }
        return (true, p1_un("-", r.1))
    }
    if cursor::pz_at(kinds, texts, pos, "*") {
        cursor::pz_next(pos)
        let r = p1_unary(kinds, texts, pos, errs, lines, cols)
        if !r.0 {
            return r
        }
        return (true, p1_un("*", r.1))
    }
    return p1_suffix(kinds, texts, pos, errs, lines, cols)
}

fn p1_suffix(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, lines: vec<i32>, cols: vec<i32>) -> (bool, str) {
    if cursor::pz_is_ident(kinds, texts, pos) {
        let name = texts[pos[0]]
        if name == "null" {
            return (false, "")
        }
        if name == "box" && cursor::pz_next_at(kinds, texts, pos, 1, "(") {
            return (false, "")
        }
        if cursor::pz_next_at(kinds, texts, pos, 1, "::") {
            if p1_is_comp_enum(name) {
                return p1_enum_after(kinds, texts, pos, errs, name, lines, cols)
            }
            return (false, "")
        }
        if p1_is_generic(kinds, texts, pos, errs, lines, cols) {
            return (false, "")
        }
        if name == "vec" && cursor::pz_next_at(kinds, texts, pos, 1, "<") {
            return (false, "")
        }
        cursor::pz_next(pos)
        if cursor::pz_at(kinds, texts, pos, "(") {
            return p1_call_args(kinds, texts, pos, errs, name, lines, cols)
        }
        if cursor::pz_at(kinds, texts, pos, "{") {
            if cursor::pz_next_kind(kinds, pos, 1, "ident") && cursor::pz_next_at(kinds, texts, pos, 2, ":") {
                pos[0] = pos[0] - 1
                return p1p3b::p1_struct_after(kinds, texts, pos, errs, name, lines, cols)
            }
        }
        if cursor::pz_at(kinds, texts, pos, "::") {
            return (false, "")
        }
        let base = concat("{\"kind\":\"var\",\"name\":", p1json::p1_quoted(name), "}")
        return p1p3b::p1_postfix(kinds, texts, pos, errs, base, lines, cols)
    }
    return p1_atom(kinds, texts, pos, errs, lines, cols)
}

fn p1_call_args(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, name: str, lines: vec<i32>, cols: vec<i32>) -> (bool, str) {
    cursor::pz_next(pos)
    let mut args = vec<str>()
    if cursor::pz_at(kinds, texts, pos, ")") {
        cursor::pz_next(pos)
        let empty_call = concat("{\"kind\":\"call\",\"name\":", p1json::p1_quoted(name), ",\"args\":", p1json::p1_join(args), "}")
        return p1p3b::p1_postfix(kinds, texts, pos, errs, empty_call, lines, cols)
    }
    let a0 = p1_expr(kinds, texts, pos, errs, lines, cols)
    if !a0.0 {
        return a0
    }
    push(args, a0.1)
    while cursor::pz_at(kinds, texts, pos, ",") {
        cursor::pz_next(pos)
        if cursor::pz_at(kinds, texts, pos, ")") {
            break
        }
        let a = p1_expr(kinds, texts, pos, errs, lines, cols)
        if !a.0 {
            return a
        }
        push(args, a.1)
    }
    if !cursor::pz_at(kinds, texts, pos, ")") {
        return (false, "")
    }
    cursor::pz_next(pos)
    let call = concat("{\"kind\":\"call\",\"name\":", p1json::p1_quoted(name), ",\"args\":", p1json::p1_join(args), "}")
    return p1p3b::p1_postfix(kinds, texts, pos, errs, call, lines, cols)
}

# `(` expr `)` 分组 vs `(` expr `,` ... `)` 元组（调用时 `(` 已消费）。
fn p1_paren_or_tuple(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, lines: vec<i32>, cols: vec<i32>) -> (bool, str) {
    cursor::pz_next(pos)
    if cursor::pz_at(kinds, texts, pos, ")") {
        return (false, "")
    }
    let first = p1_expr(kinds, texts, pos, errs, lines, cols)
    if !first.0 {
        return first
    }
    if !cursor::pz_at(kinds, texts, pos, ",") {
        if !cursor::pz_at(kinds, texts, pos, ")") {
            return (false, "")
        }
        cursor::pz_next(pos)
        return p1p3b::p1_postfix(kinds, texts, pos, errs, first.1, lines, cols)
    }
    let mut elems = vec<str>()
    push(elems, first.1)
    while cursor::pz_at(kinds, texts, pos, ",") {
        cursor::pz_next(pos)
        if cursor::pz_at(kinds, texts, pos, ")") {
            break
        }
        let e = p1_expr(kinds, texts, pos, errs, lines, cols)
        if !e.0 {
            return e
        }
        push(elems, e.1)
    }
    if !cursor::pz_at(kinds, texts, pos, ")") {
        return (false, "")
    }
    cursor::pz_next(pos)
    return p1p3b::p1_postfix(kinds, texts, pos, errs, p1json::p1_tuple_json(elems), lines, cols)
}

# `[` ... `]` 数组字面量（调用时 `[` 未消费；空即 `[]`，尾逗号容忍）。
fn p1_array_lit(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, lines: vec<i32>, cols: vec<i32>) -> (bool, str) {
    cursor::pz_next(pos)
    let mut elems = vec<str>()
    if cursor::pz_at(kinds, texts, pos, "]") {
        cursor::pz_next(pos)
        return p1p3b::p1_postfix(kinds, texts, pos, errs, p1json::p1_array_json(elems), lines, cols)
    }
    let e0 = p1_expr(kinds, texts, pos, errs, lines, cols)
    if !e0.0 {
        return e0
    }
    push(elems, e0.1)
    while cursor::pz_at(kinds, texts, pos, ",") {
        cursor::pz_next(pos)
        if cursor::pz_at(kinds, texts, pos, "]") {
            break
        }
        let e = p1_expr(kinds, texts, pos, errs, lines, cols)
        if !e.0 {
            return e
        }
        push(elems, e.1)
    }
    if !cursor::pz_at(kinds, texts, pos, "]") {
        return (false, "")
    }
    cursor::pz_next(pos)
    return p1p3b::p1_postfix(kinds, texts, pos, errs, p1json::p1_array_json(elems), lines, cols)
}

fn p1_atom(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, lines: vec<i32>, cols: vec<i32>) -> (bool, str) {
    if cursor::pz_kw(kinds, texts, pos, "match") {
        let m = p1p3c::p1_match(kinds, texts, pos, errs, lines, cols)
        if !m.0 {
            return m
        }
        return p1p3b::p1_postfix(kinds, texts, pos, errs, m.1, lines, cols)
    }
    if cursor::pz_at(kinds, texts, pos, "|") || cursor::pz_at(kinds, texts, pos, "||") {
        let c = p1p3c::p1_closure(kinds, texts, pos, errs, lines, cols)
        if !c.0 {
            return c
        }
        return p1p3b::p1_postfix(kinds, texts, pos, errs, c.1, lines, cols)
    }
    if cursor::pz_at_kind(kinds, pos, "int") {
        let t = texts[pos[0]]
        let pr = parse_int(t)
        if !pr.0 {
            return (false, "")
        }
        let norm = to_string(pr.1)
        cursor::pz_next(pos)
        if cursor::pz_at(kinds, texts, pos, "(") {
            return (false, "")
        }
        if cursor::pz_at(kinds, texts, pos, "::") {
            return (false, "")
        }
        let base_num = concat("{\"kind\":\"num\",\"value\":", norm, "}")
        return p1p3b::p1_postfix(kinds, texts, pos, errs, base_num, lines, cols)
    }
    if cursor::pz_at_kind(kinds, pos, "float") || cursor::pz_at_kind(kinds, pos, "char") {
        return (false, "")
    }
    if cursor::pz_at_kind(kinds, pos, "string") {
        let s = texts[pos[0]]
        cursor::pz_next(pos)
        if cursor::pz_at(kinds, texts, pos, "(") {
            return (false, "")
        }
        let base_str = concat("{\"kind\":\"str\",\"value\":", p1json::p1_quoted(s), "}")
        return p1p3b::p1_postfix(kinds, texts, pos, errs, base_str, lines, cols)
    }
    if cursor::pz_kw(kinds, texts, pos, "true") {
        cursor::pz_next(pos)
        if cursor::pz_at(kinds, texts, pos, "(") {
            return (false, "")
        }
        return p1p3b::p1_postfix(kinds, texts, pos, errs, "{\"kind\":\"bool\",\"value\":true}", lines, cols)
    }
    if cursor::pz_kw(kinds, texts, pos, "false") {
        cursor::pz_next(pos)
        if cursor::pz_at(kinds, texts, pos, "(") {
            return (false, "")
        }
        return p1p3b::p1_postfix(kinds, texts, pos, errs, "{\"kind\":\"bool\",\"value\":false}", lines, cols)
    }
    if cursor::pz_at(kinds, texts, pos, "(") {
        return p1_paren_or_tuple(kinds, texts, pos, errs, lines, cols)
    }
    if cursor::pz_at(kinds, texts, pos, "[") {
        return p1_array_lit(kinds, texts, pos, errs, lines, cols)
    }
    return (false, "")
}
