# parser/stmt_defs —— 顶层定义(fn/struct/enum/trait/impl)，仅依赖 cursor/typ/stmt。
# 源自 parser/stmt.hz 同名区段逐行搬移(纯搬移，仅 pz_block 改为 stmt::pz_block 跨模块调用)。
import cursor
import typ
import stmt

fn pz_fn_def(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    cursor::pz_next(pos)
    if !cursor::pz_is_ident(kinds, texts, pos) {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected function name")
    }
    cursor::pz_next(pos)
    if cursor::pz_at(kinds, texts, pos, "<") {
        if !typ::pz_typarams(kinds, texts, pos, errs, lines, cols) {
            return false
        }
    }
    if !cursor::pz_at(kinds, texts, pos, "(") {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected '(' after function name")
    }
    if !typ::pz_params(kinds, texts, pos, errs, false, lines, cols) {
        return false
    }
    if cursor::pz_at(kinds, texts, pos, "->") {
        cursor::pz_next(pos)
        if !typ::pz_type(kinds, texts, pos, errs, lines, cols) {
            return false
        }
    }
    if !stmt::pz_block(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
        return false
    }
    stats[0] = stats[0] + 1
    return true
}

fn pz_struct_def(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    cursor::pz_next(pos)
    if !cursor::pz_is_ident(kinds, texts, pos) {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected struct name")
    }
    cursor::pz_next(pos)
    if cursor::pz_at(kinds, texts, pos, "<") {
        if !typ::pz_typarams(kinds, texts, pos, errs, lines, cols) {
            return false
        }
    }
    if !cursor::pz_at(kinds, texts, pos, "{") {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected '{' after struct name")
    }
    cursor::pz_next(pos)
    while !cursor::pz_at(kinds, texts, pos, "}") && !cursor::pz_eof(kinds, pos) {
        if cursor::pz_kw(kinds, texts, pos, "weak") {
            cursor::pz_next(pos)
        }
        if !cursor::pz_is_ident(kinds, texts, pos) {
            return cursor::pz_fail(errs, texts, pos, lines, cols, "expected field name")
        }
        cursor::pz_next(pos)
        if !cursor::pz_at(kinds, texts, pos, ":") {
            return cursor::pz_fail(errs, texts, pos, lines, cols, "expected ':' after field name")
        }
        cursor::pz_next(pos)
        if !typ::pz_type(kinds, texts, pos, errs, lines, cols) {
            return false
        }
        if cursor::pz_at(kinds, texts, pos, ",") {
            cursor::pz_next(pos)
        } else {
            break
        }
    }
    if !cursor::pz_at(kinds, texts, pos, "}") {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected '}' after struct fields")
    }
    cursor::pz_next(pos)
    stats[1] = stats[1] + 1
    return true
}

fn pz_enum_def(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    cursor::pz_next(pos)
    if !cursor::pz_is_ident(kinds, texts, pos) {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected enum name")
    }
    cursor::pz_next(pos)
    if cursor::pz_at(kinds, texts, pos, "<") {
        if !typ::pz_typarams(kinds, texts, pos, errs, lines, cols) {
            return false
        }
    }
    if !cursor::pz_at(kinds, texts, pos, "{") {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected '{' after enum name")
    }
    cursor::pz_next(pos)
    while !cursor::pz_at(kinds, texts, pos, "}") && !cursor::pz_eof(kinds, pos) {
        if !cursor::pz_is_ident(kinds, texts, pos) {
            return cursor::pz_fail(errs, texts, pos, lines, cols, "expected variant name")
        }
        cursor::pz_next(pos)
        if cursor::pz_at(kinds, texts, pos, "(") {
            cursor::pz_next(pos)
            if !cursor::pz_at(kinds, texts, pos, ")") {
                if !typ::pz_type(kinds, texts, pos, errs, lines, cols) {
                    return false
                }
                while cursor::pz_at(kinds, texts, pos, ",") {
                    cursor::pz_next(pos)
                    if cursor::pz_at(kinds, texts, pos, ")") {
                        break
                    }
                    if !typ::pz_type(kinds, texts, pos, errs, lines, cols) {
                        return false
                    }
                }
            }
            if !cursor::pz_at(kinds, texts, pos, ")") {
                return cursor::pz_fail(errs, texts, pos, lines, cols, "expected ')' after variant payloads")
            }
            cursor::pz_next(pos)
        }
        if cursor::pz_at(kinds, texts, pos, ",") {
            cursor::pz_next(pos)
        } else {
            break
        }
    }
    if !cursor::pz_at(kinds, texts, pos, "}") {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected '}' after enum variants")
    }
    cursor::pz_next(pos)
    stats[2] = stats[2] + 1
    return true
}

fn pz_trait_def(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    cursor::pz_next(pos)
    if !cursor::pz_is_ident(kinds, texts, pos) {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected trait name")
    }
    cursor::pz_next(pos)
    if !cursor::pz_at(kinds, texts, pos, "{") {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected '{' after trait name")
    }
    cursor::pz_next(pos)
    while !cursor::pz_at(kinds, texts, pos, "}") && !cursor::pz_eof(kinds, pos) {
        if !cursor::pz_kw(kinds, texts, pos, "fn") {
            return cursor::pz_fail(errs, texts, pos, lines, cols, "expected 'fn' in trait definition")
        }
        cursor::pz_next(pos)
        if !cursor::pz_is_ident(kinds, texts, pos) {
            return cursor::pz_fail(errs, texts, pos, lines, cols, "expected method name in trait")
        }
        cursor::pz_next(pos)
        if !cursor::pz_at(kinds, texts, pos, "(") {
            return cursor::pz_fail(errs, texts, pos, lines, cols, "expected '(' after method name")
        }
        if !typ::pz_params(kinds, texts, pos, errs, true, lines, cols) {
            return false
        }
        if cursor::pz_at(kinds, texts, pos, "->") {
            cursor::pz_next(pos)
            if !typ::pz_type(kinds, texts, pos, errs, lines, cols) {
                return false
            }
        }
        if cursor::pz_at(kinds, texts, pos, ";") {
            cursor::pz_next(pos)
        }
    }
    if !cursor::pz_at(kinds, texts, pos, "}") {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected '}' after trait methods")
    }
    cursor::pz_next(pos)
    stats[3] = stats[3] + 1
    return true
}

fn pz_impl_def(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    cursor::pz_next(pos)
    if !cursor::pz_is_ident(kinds, texts, pos) {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected trait or type name after 'impl'")
    }
    cursor::pz_next(pos)
    if cursor::pz_at(kinds, texts, pos, "<") {
        if !typ::pz_typarams(kinds, texts, pos, errs, lines, cols) {
            return false
        }
    }
    if cursor::pz_kw(kinds, texts, pos, "for") {
        cursor::pz_next(pos)
        if !cursor::pz_is_ident(kinds, texts, pos) {
            return cursor::pz_fail(errs, texts, pos, lines, cols, "expected target type after 'for'")
        }
        cursor::pz_next(pos)
        if cursor::pz_at(kinds, texts, pos, "<") {
            if !typ::pz_typarams(kinds, texts, pos, errs, lines, cols) {
                return false
            }
        }
    }
    if !cursor::pz_at(kinds, texts, pos, "{") {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected '{' after target type")
    }
    cursor::pz_next(pos)
    while !cursor::pz_at(kinds, texts, pos, "}") && !cursor::pz_eof(kinds, pos) {
        if !cursor::pz_kw(kinds, texts, pos, "fn") {
            return cursor::pz_fail(errs, texts, pos, lines, cols, "expected 'fn' in impl block")
        }
        cursor::pz_next(pos)
        if !cursor::pz_is_ident(kinds, texts, pos) {
            return cursor::pz_fail(errs, texts, pos, lines, cols, "expected method name in impl")
        }
        cursor::pz_next(pos)
        if cursor::pz_at(kinds, texts, pos, "<") {
            if !typ::pz_typarams(kinds, texts, pos, errs, lines, cols) {
                return false
            }
        }
        if !cursor::pz_at(kinds, texts, pos, "(") {
            return cursor::pz_fail(errs, texts, pos, lines, cols, "expected '(' after method name")
        }
        if !typ::pz_params(kinds, texts, pos, errs, true, lines, cols) {
            return false
        }
        if cursor::pz_at(kinds, texts, pos, "->") {
            cursor::pz_next(pos)
            if !typ::pz_type(kinds, texts, pos, errs, lines, cols) {
                return false
            }
        }
        if !stmt::pz_block(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
            return false
        }
        stats[0] = stats[0] + 1
    }
    if !cursor::pz_at(kinds, texts, pos, "}") {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected '}' after impl block")
    }
    cursor::pz_next(pos)
    stats[4] = stats[4] + 1
    return true
}
