# parser/stmt —— 语句分发(块/顶层分发)，依赖 cursor/expr/atom/stmt_defs/stmt_ctrl。
# 由原 parser/stmt.hz 拆分：定义组搬至 stmt_defs.hz，控制流搬至 stmt_ctrl.hz；
# 本文件仅保留 pz_block 与 Pz_stmt 分发(纯搬移，分发目标改为跨模块 qualified 调用)。
import cursor
import expr
import atom
import stmt_defs
import stmt_ctrl

fn pz_block(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if !cursor::pz_at(kinds, texts, pos, "{") {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected '{'")
    }
    cursor::pz_next(pos)
    while !cursor::pz_at(kinds, texts, pos, "}") && !cursor::pz_eof(kinds, pos) {
        if cursor::pz_at_kind(kinds, pos, "eof") {
            return cursor::pz_fail(errs, texts, pos, lines, cols, "unexpected end in block")
        }
        if !pz_stmt(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
            return false
        }
    }
    if !cursor::pz_at(kinds, texts, pos, "}") {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected '}'")
    }
    cursor::pz_next(pos)
    return true
}

fn pz_stmt(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if cursor::pz_at_kind(kinds, pos, "eof") {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "unexpected end of file")
    }
    if cursor::pz_kw(kinds, texts, pos, "import") {
        return stmt_ctrl::pz_import(kinds, texts, pos, errs, stats, lines, cols)
    }
    if cursor::pz_kw(kinds, texts, pos, "export") {
        return stmt_ctrl::pz_export(kinds, texts, pos, errs, stats, lines, cols)
    }
    if cursor::pz_kw(kinds, texts, pos, "fn") {
        return stmt_defs::pz_fn_def(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    if cursor::pz_kw(kinds, texts, pos, "struct") {
        return stmt_defs::pz_struct_def(kinds, texts, pos, errs, stats, lines, cols)
    }
    if cursor::pz_kw(kinds, texts, pos, "enum") {
        return stmt_defs::pz_enum_def(kinds, texts, pos, errs, stats, lines, cols)
    }
    if cursor::pz_kw(kinds, texts, pos, "trait") {
        return stmt_defs::pz_trait_def(kinds, texts, pos, errs, stats, lines, cols)
    }
    if cursor::pz_kw(kinds, texts, pos, "impl") {
        return stmt_defs::pz_impl_def(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    if cursor::pz_kw(kinds, texts, pos, "let") {
        return stmt_ctrl::pz_let(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    if cursor::pz_kw(kinds, texts, pos, "return") {
        cursor::pz_next(pos)
        if atom::pz_expr_start(kinds, texts, pos) {
            return expr::pz_expr(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
        }
        return true
    }
    if cursor::pz_kw(kinds, texts, pos, "if") {
        return stmt_ctrl::pz_if_stmt(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    if cursor::pz_kw(kinds, texts, pos, "for") {
        return stmt_ctrl::pz_for_stmt(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    if cursor::pz_kw(kinds, texts, pos, "while") {
        return stmt_ctrl::pz_while_stmt(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    if cursor::pz_kw(kinds, texts, pos, "break") || cursor::pz_kw(kinds, texts, pos, "continue") {
        cursor::pz_next(pos)
        return true
    }
    if cursor::pz_kw(kinds, texts, pos, "defer") {
        cursor::pz_next(pos)
        return pz_stmt(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    if cursor::pz_at(kinds, texts, pos, "{") {
        return pz_block(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    if !expr::pz_expr(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
        return false
    }
    if cursor::pz_at(kinds, texts, pos, "=") {
        cursor::pz_next(pos)
        return expr::pz_expr(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    return true
}
