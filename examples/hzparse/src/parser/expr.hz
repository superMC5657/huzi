# parser/expr —— 表达式优先级链(赋值/逻辑/比较/位/算术/一元/后缀与实参表)，依赖 cursor/atom。
# 源自 parser.hz 表达式优先级链区段逐行搬移。
import cursor
import atom

# ---- 表达式(优先级链) ----
fn pz_expr(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    dep[0] = dep[0] + 1
    if dep[0] > maxd[0] {
        maxd[0] = dep[0]
    }
    let ok = pz_assign(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    dep[0] = dep[0] - 1
    return ok
}

fn pz_assign(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if !pz_or(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
        return false
    }
    if cursor::pz_at(kinds, texts, pos, "=") {
        cursor::pz_next(pos)
        return pz_expr(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    return true
}

fn pz_or(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if !pz_and(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
        return false
    }
    while cursor::pz_at(kinds, texts, pos, "||") {
        cursor::pz_next(pos)
        if !pz_and(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
            return false
        }
    }
    return true
}

fn pz_and(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if !pz_eq(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
        return false
    }
    while cursor::pz_at(kinds, texts, pos, "&&") {
        cursor::pz_next(pos)
        if !pz_eq(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
            return false
        }
    }
    return true
}

fn pz_eq(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if !pz_cmp(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
        return false
    }
    while cursor::pz_at(kinds, texts, pos, "==") || cursor::pz_at(kinds, texts, pos, "!=") {
        cursor::pz_next(pos)
        if !pz_cmp(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
            return false
        }
    }
    return true
}

fn pz_cmp(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if !pz_bor(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
        return false
    }
    while cursor::pz_at(kinds, texts, pos, "<") || cursor::pz_at(kinds, texts, pos, "<=") || cursor::pz_at(kinds, texts, pos, ">") || cursor::pz_at(kinds, texts, pos, ">=") {
        cursor::pz_next(pos)
        if !pz_bor(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
            return false
        }
    }
    return true
}

fn pz_bor(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if !pz_band(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
        return false
    }
    while cursor::pz_at(kinds, texts, pos, "|") || cursor::pz_at(kinds, texts, pos, "^") {
        cursor::pz_next(pos)
        if !pz_band(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
            return false
        }
    }
    return true
}

fn pz_band(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if !pz_add(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
        return false
    }
    while cursor::pz_at(kinds, texts, pos, "&") {
        cursor::pz_next(pos)
        if !pz_add(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
            return false
        }
    }
    return true
}

fn pz_add(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if !pz_mul(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
        return false
    }
    while cursor::pz_at(kinds, texts, pos, "+") || cursor::pz_at(kinds, texts, pos, "-") {
        cursor::pz_next(pos)
        if !pz_mul(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
            return false
        }
    }
    return true
}

fn pz_mul(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if !pz_unary(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
        return false
    }
    while cursor::pz_at(kinds, texts, pos, "*") || cursor::pz_at(kinds, texts, pos, "/") || cursor::pz_at(kinds, texts, pos, "%") {
        cursor::pz_next(pos)
        if !pz_unary(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
            return false
        }
    }
    return true
}

fn pz_unary(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if cursor::pz_at(kinds, texts, pos, "!") || cursor::pz_at(kinds, texts, pos, "-") {
        cursor::pz_next(pos)
        return pz_unary(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
    }
    return pz_postfix(kinds, texts, pos, errs, stats, dep, maxd, lines, cols)
}

fn pz_postfix(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    if !atom::pz_primary(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
        return false
    }
    while true {
        if cursor::pz_at(kinds, texts, pos, "[") {
            cursor::pz_next(pos)
            if !pz_expr(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
                return false
            }
            if !cursor::pz_at(kinds, texts, pos, "]") {
                return cursor::pz_fail(errs, texts, pos, lines, cols, "expected ']' after index")
            }
            cursor::pz_next(pos)
        } elif cursor::pz_at(kinds, texts, pos, ".") {
            cursor::pz_next(pos)
            if cursor::pz_at_kind(kinds, pos, "int") || cursor::pz_at_kind(kinds, pos, "float") {
                # 元组下标:词法层把 `t.1.0` 的第二段切成 float(`1.0`),
                # 结构上仍按下标整体消费。
                cursor::pz_next(pos)
            } elif cursor::pz_is_ident(kinds, texts, pos) {
                cursor::pz_next(pos)
                if cursor::pz_at(kinds, texts, pos, "(") {
                    if !pz_paren_args(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
                        return false
                    }
                }
            } else {
                return cursor::pz_fail(errs, texts, pos, lines, cols, "expected field name after '.'")
            }
        } elif cursor::pz_at(kinds, texts, pos, "(") {
            if !pz_paren_args(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
                return false
            }
        } elif cursor::pz_at(kinds, texts, pos, "?") {
            cursor::pz_next(pos)
        } else {
            break
        }
    }
    return true
}

# 调用实参表(调用时尚未消费 `(`)。
fn pz_paren_args(kinds: vec<str>, texts: vec<str>, pos: vec<i32>, errs: vec<str>, stats: vec<i32>, dep: vec<i32>, maxd: vec<i32>, lines: vec<i32>, cols: vec<i32>) -> bool {
    cursor::pz_next(pos)
    if cursor::pz_at(kinds, texts, pos, ")") {
        cursor::pz_next(pos)
        return true
    }
    if !pz_expr(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
        return false
    }
    while cursor::pz_at(kinds, texts, pos, ",") {
        cursor::pz_next(pos)
        if cursor::pz_at(kinds, texts, pos, ")") {
            break
        }
        if !pz_expr(kinds, texts, pos, errs, stats, dep, maxd, lines, cols) {
            return false
        }
    }
    if !cursor::pz_at(kinds, texts, pos, ")") {
        return cursor::pz_fail(errs, texts, pos, lines, cols, "expected ')' after arguments")
    }
    cursor::pz_next(pos)
    return true
}
