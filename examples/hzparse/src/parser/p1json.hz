# parser/p1json —— P1 落盘 JSON 转义/拼装（对标 hzast json.hz + ast_json.rs:10-28）。
# 仅 5 种转义，键序固定，紧凑无空白；超子集由调用方判非零，本文件不判子集。
fn p1_escape(s: str) -> str {
    let n = len(s)
    let mut res = ""
    let mut i = 0
    while i < n {
        let ch = substring(s, i, i + 1)
        if ch == "\"" {
            res = concat(res, "\\\"")
        } elif ch == "\\" {
            res = concat(res, "\\\\")
        } elif ch == "\n" {
            res = concat(res, "\\n")
        } elif ch == "\r" {
            res = concat(res, "\\r")
        } elif ch == "\t" {
            res = concat(res, "\\t")
        } else {
            res = concat(res, ch)
        }
        i = i + 1
    }
    return res
}

fn p1_quoted(s: str) -> str {
    return concat("\"", p1_escape(s), "\"")
}

# 字符串向量拼装 `["a","b",...]`（空即 `[]`）。
fn p1_strs(ss: vec<str>) -> str {
    let n = len(ss)
    let mut res = "["
    let mut i = 0
    while i < n {
        if i > 0 {
            res = concat(res, ",")
        }
        res = concat(res, p1_quoted(ss[i]))
        i = i + 1
    }
    return concat(res, "]")
}

# 已成形 JSON 片段向量拼装 `[ {...}, {...} ]`（调用方保证片段合法）。
fn p1_join(parts: vec<str>) -> str {
    let n = len(parts)
    let mut res = "["
    let mut i = 0
    while i < n {
        if i > 0 {
            res = concat(res, ",")
        }
        res = concat(res, parts[i])
        i = i + 1
    }
    return concat(res, "]")
}

# P3 复合值 JSON 形状（键序固定，与 hzast json.hz + ast_json.rs 同序；只拼装不判子集）。
fn p1_tuple_json(elems: vec<str>) -> str {
    return concat("{\"kind\":\"tuple\",\"elems\":", p1_join(elems), "}")
}

fn p1_array_json(elems: vec<str>) -> str {
    return concat("{\"kind\":\"array\",\"elems\":", p1_join(elems), "}")
}

fn p1_index_json(arr: str, idx: str) -> str {
    return concat("{\"kind\":\"index\",\"array\":", arr, ",\"index\":", idx, "}")
}

fn p1_enum_json(full: str, args: vec<str>) -> str {
    return concat("{\"kind\":\"enum\",\"name\":", p1_quoted(full), ",\"args\":", p1_join(args), "}")
}

fn p1_try_json(inner: str) -> str {
    return concat("{\"kind\":\"try\",\"expr\":", inner, "}")
}

# P3b 结构/字段/方法/fstring JSON 形状（键序与 hzast json.hz + ast_json.rs 同序）。
fn p1_struct_json(name: str, fields: vec<str>) -> str {
    return concat("{\"kind\":\"struct\",\"name\":", p1_quoted(name), ",\"fields\":", p1_join(fields), "}")
}

fn p1_field_entry(fname: str, val: str) -> str {
    return concat("{\"name\":", p1_quoted(fname), ",\"value\":", val, "}")
}

fn p1_field_json(base: str, field: str) -> str {
    return concat("{\"kind\":\"field\",\"base\":", base, ",\"field\":", p1_quoted(field), "}")
}

fn p1_method_json(recv: str, method: str, args: vec<str>) -> str {
    return concat("{\"kind\":\"method\",\"receiver\":", recv, ",\"method\":", p1_quoted(method), ",\"args\":", p1_join(args), "}")
}

fn p1_fstring_json(tpl: str, args: vec<str>) -> str {
    return concat("{\"kind\":\"fstring\",\"template\":", p1_quoted(tpl), ",\"args\":", p1_join(args), "}")
}

fn p1_type_json(name: str, args: vec<str>) -> str {
    return concat("{\"kind\":\"type\",\"name\":", p1_quoted(name), ",\"args\":", p1_join(args), "}")
}

# P3c match/closure JSON 形状（键序与 hzast json.hz + ast_json.rs 同序；只拼装不判子集）。
fn p1_variant_pat_json(full: str, bindings: vec<str>) -> str {
    return concat("{\"kind\":\"variant\",\"name\":", p1_quoted(full), ",\"bindings\":", p1_strs(bindings), "}")
}

fn p1_arm_json(pat: str, guard: str, body: str) -> str {
    return concat("{\"pattern\":", pat, ",\"guard\":", guard, ",\"body\":", body, "}")
}

fn p1_match_json(scr: str, arms: vec<str>) -> str {
    return concat("{\"kind\":\"match\",\"scrutinee\":", scr, ",\"arms\":", p1_join(arms), "}")
}

fn p1_closure_json(params: vec<str>, body: str) -> str {
    return concat("{\"kind\":\"closure\",\"params\":", p1_strs(params), ",\"body\":", body, "}")
}
