import core.result

fn parse_num(raw: str) -> Result<i32> {
    let r = parse_int(raw)
    if !r.0 {
        return result::err_i32(concat("not a number: ", raw))
    }
    return result::ok_i32(r.1)
}

fn checked_double(raw: str) -> Result<i32> {
    let n = parse_num(raw)?
    if n > 100 {
        return result::err_i32("too large")
    }
    return result::ok_i32(n * 2)
}

fn checked_sum(a: str, b: str) -> Result<i32> {
    let x = parse_num(a)?
    let y = parse_num(b)?
    return result::ok_i32(x + y)
}

fn main() -> i32 {
    print(result::unwrap_or(checked_double("21"), -1))
    print(result::unwrap_or(checked_double("60"), -1))
    print(result::unwrap_or(checked_double("abc"), -1))
    print(result::unwrap_or(checked_double("999"), -1))
    print(result::unwrap_or(checked_sum("3", "4"), -1))
    print(result::unwrap_or(checked_sum("3", "x"), -1))
    print(result::is_ok(checked_double("21")))
    print(result::err_msg(checked_double("abc")))
    return 0
}
