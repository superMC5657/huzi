import core.assert
import core.result
import alloc.stringx
import std.http

fn main() -> i32 {
    let req = http::http_build_request("example.com", "/index.html")
    assert::assert_true(stringx::starts_with(req, "GET /index.html HTTP/1.1\r\n"))
    assert::assert_true(contains(req, "Host: example.com"))
    assert::assert_true(contains(req, "Connection: close"))
    assert::assert_true(stringx::starts_with(http::http_build_request("h.io", ""), "GET / HTTP/1.1\r\n"))

    let resp = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\n\r\nhello"
    assert::assert_eq_i32(http::http_status_code(resp), 200)
    assert::assert_eq_str(http::http_body(resp), "hello")
    let ok_res = http::http_parse(resp)
    assert::assert_true(result::is_ok(ok_res))
    assert::assert_eq_str(result::unwrap_or(ok_res, ""), "hello")

    let no_reason = "HTTP/1.0 204\r\n\r\n"
    assert::assert_eq_i32(http::http_status_code(no_reason), 204)
    assert::assert_eq_str(http::http_body(no_reason), "")

    let nf = "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n"
    assert::assert_eq_i32(http::http_status_code(nf), 404)
    let nf_res = http::http_parse(nf)
    assert::assert_true(result::is_err(nf_res))
    assert::assert_eq_str(result::err_msg(nf_res), "http status 404")

    assert::assert_eq_i32(http::http_status_code("garbage"), 0)
    assert::assert_eq_i32(http::http_status_code("HTTP/1.1 oops"), 0)
    assert::assert_eq_str(http::http_body("no separator"), "")
    print("http_test passed")
    return 0
}
