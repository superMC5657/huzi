import mods.calc_input
import mods.calc_core

fn eval_once(expr: str) -> bool {
    if expr[0] == 'q' {
        return false
    }
    let op_idx = calc_input::find_operator(expr)
    if op_idx < 0 {
        print("无法识别,示例: 12.5*3")
        return true
    }
    let a = calc_input::parse_number(expr, 0, op_idx)
    let b = calc_input::parse_number(expr, op_idx + 1, len(expr))
    let op = expr[op_idx]
    if op == '/' && b == 0.0 {
        print("错误: 除数为 0")
        return true
    }
    print(concat("= ", to_string(calc_core::calculate(a, op, b))))
    return true
}

fn main() -> i32 {
    print("四则计算器 (输入 q 退出, 示例: 12.5*3)")
    let mut done = false
    while !done {
        let expr = calc_input::read_expression
        if is_eof() {
            done = true
        } else {
            done = !eval_once(expr)
        }
    }
    print("再见!")
    0
}
