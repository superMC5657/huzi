enum Pair {
    Two(i32, i32),
    Tagged(str, i32),
    One(i32),
    Empty,
}

enum Shape2 {
    Circle(f64),
    Rect2(f64, f64),
    Point2D,
}

enum Code {
    Pair2(char, bool),
    Unit,
}

struct Size {
    w: i32,
    h: i32,
}

enum Box2 {
    Rect(Size, str),
    Empty,
}

fn sum2(p: Pair) -> i32 {
    return match p {
    Pair::Two(a, b) => a + b,
    Pair::Tagged(name, n) => n,
    Pair::One(x) => x,
    Pair::Empty => 0,
}
}

print(sum2(Pair::Two(3, 4)))

print(sum2(Pair::Tagged("seven", 7)))

print(sum2(Pair::One(5)))

print(sum2(Pair::Empty))

print(Pair::Two(1, 2) == Pair::Two(1, 2))

print(Pair::Two(1, 2) == Pair::Two(1, 3))

print(Pair::Two(1, 2) != Pair::One(1))

print(Pair::Tagged("a", 1) == Pair::Tagged("a", 1))

print(Pair::Tagged("a", 1) == Pair::Tagged("b", 1))

print(Pair::Empty == Pair::Empty)

print(Pair::One(9) != Pair::One(8))

fn area2(s: Shape2) -> f64 {
    return match s {
    Shape2::Circle(r) => 3.14159 * r * r,
    Shape2::Rect2(w, h) => w * h,
    Shape2::Point2D => 0.0,
}
}

print(area2(Shape2::Rect2(3.0, 4.0)))

print(Shape2::Circle(2.0) == Shape2::Circle(2.0))

print(Shape2::Rect2(1.0, 2.0) == Shape2::Rect2(1.0, 2.0))

print(Shape2::Rect2(1.0, 2.0) == Shape2::Rect2(1.0, 3.0))

print(Shape2::Circle(1.0) == Shape2::Rect2(1.0, 1.0))

print(Code::Pair2('a', true) == Code::Pair2('a', true))

print(Code::Pair2('a', true) == Code::Pair2('b', true))

print(Code::Pair2('a', true) == Code::Pair2('a', false))

fn label(b: Box2) -> str {
    return match b {
    Box2::Rect(s, name) => name,
    Box2::Empty => "none",
}
}

let r = Box2::Rect(Size { w: 3, h: 4 }, "box")

print(label(r))

print(r == Box2::Rect(Size { w: 3, h: 4 }, "box"))

print(r == Box2::Rect(Size { w: 3, h: 5 }, "box"))

print(r == Box2::Empty)
