fn worker_sum(n: i32) -> i32 {
    let mut sum = 0
    let mut i = 1
    while i <= n {
        sum = sum + i
        i = i + 1
    }
    return sum
}

fn worker_square(n: i32) -> i32 {
    return n * n
}

fn main() -> i32 {
    let t1 = spawn(worker_sum, 10)
    let t2 = spawn(worker_sum, 20)
    let t3 = spawn(worker_square, 12)
    let r1 = join(t1)
    let r2 = join(t2)
    let r3 = join(t3)
    print(r1)
    print(r2)
    print(r3)
    return 0
}
