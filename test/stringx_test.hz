import core.assert
import alloc.stringx

fn main() -> i32 {
    let parts = vec("alpha", "beta", "gamma")
    let s = stringx::join(parts, "-")
    assert::assert_eq_str(s, "alpha-beta-gamma")
    let rep = stringx::repeat("hz", 3)
    assert::assert_eq_str(rep, "hzhzhz")
    assert::assert_true(stringx::starts_with("hello world", "hello"))
    assert::assert_true(!stringx::starts_with("hello world", "world"))
    assert::assert_true(stringx::ends_with("hello world", "world"))
    assert::assert_true(!stringx::ends_with("hello world", "hello"))
    let padded = stringx::pad_left("42", 5, "0")
    assert::assert_eq_str(padded, "00042")
    let lines = stringx::split_lines("a\nb\nc")
    assert::assert_eq_i32(len(lines), 3)
    assert::assert_eq_str(lines[0], "a")
    assert::assert_eq_str(lines[1], "b")
    assert::assert_eq_str(lines[2], "c")
    let crlf_lines = stringx::lines("line1\r\nline2\r\nline3")
    assert::assert_eq_i32(len(crlf_lines), 3)
    assert::assert_eq_str(crlf_lines[0], "line1")
    assert::assert_eq_str(crlf_lines[1], "line2")
    assert::assert_eq_str(crlf_lines[2], "line3")
    print("stringx_test passed")
    return 0
}
