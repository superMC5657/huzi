struct Point {
    x: i32,
}

trait Printable {
    fn show(self) -> str
}

trait Displayable {
    fn show(self) -> str
}

impl Printable for Point {
    fn show(self) -> str {
        return "point"
    }
}

impl Displayable for Point {
    fn show(self) -> str {
        return "display"
    }
}

fn main() -> i32 {
    let p = Point { x: 1 }
    return 0
}
