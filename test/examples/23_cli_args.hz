# 命令行参数示例
# 演示 arg_count() 与 arg(i):运行 `./23_cli_args.exe hello 世界` 时
# arg_count() 为 3,arg(0) 是程序自身路径,arg(1)/arg(2) 是传入的参数。
# 越界或负数索引返回空串,不会崩溃。

fn main() -> i32 {
    let n = arg_count()
    print(concat("参数个数: ", to_string(n)))

    print(concat("程序名: ", arg(0)))

    let mut i = 1
    while i < n {
        print(concat(concat("参数[", to_string(i)), concat("] = ", arg(i))))
        i = i + 1
    }

    # 越界访问返回空串
    print(concat("越界 arg(99): [", concat(arg(99), "]")))
    0
}
