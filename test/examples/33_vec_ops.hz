fn main() -> i32 {
    let mut v = vec(1, 2, 3)
    print(v)
    print(pop(v))
    print(v)
    let last = pop(v)
    print("last =", last)
    print(v)
    remove(v, 0)
    print(v)
    insert(v, 0, 99)
    print(v)
    insert(v, 1, 7)
    print(v)
    print("len =", len(v))
    clear(v)
    print("len =", len(v))
    print(v)
    push(v, 10)
    push(v, 20)
    push(v, 30)
    push(v, 40)
    insert(v, 1, 99)
    print(v)
    print("len =", len(v))
    0
}
