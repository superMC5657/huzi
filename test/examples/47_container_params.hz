struct Container {
    tag: str,
    items: vec<i32>,
}

struct Registry {
    data: Map,
}

fn sum_vec(v: vec<i32>) -> i32 {
    let mut s = 0
    for x in v {
        s = s + x
    }
    return s
}

fn append_item(v: vec<i32>, item: i32) -> vec<i32> {
    push(v, item)
    return v
}

fn inspect_map(m: Map) -> i32 {
    let has_apple = map_has(m, "apple")
    print("has apple: ", has_apple)
    return map_len(m)
}

fn main() -> i32 {
    let mut v = vec(1, 2, 3)
    let s1 = sum_vec(v)
    print("sum1: ", s1)
    let v2 = append_item(v, 4)
    let s2 = sum_vec(v2)
    print("sum2: ", s2)
    let mut c = Container { tag: "my_container", items: v2 }
    print("tag: ", c.tag)
    print("direct len: ", len(c.items))
    print("direct elem 0: ", c.items[0])
    c.items[0] = 99
    print("after update 0: ", c.items[0])
    let mut direct_sum = 0
    for x in c.items {
        direct_sum = direct_sum + x
    }
    print("direct sum: ", direct_sum)
    let c_items = c.items
    let s3 = sum_vec(c_items)
    print("sum3: ", s3)
    let mut m = map_new()
    map_put(m, "apple", 10)
    map_put(m, "banana", 20)
    let l = inspect_map(m)
    print("map len: ", l)
    let reg = Registry { data: m }
    print("reg map len: ", map_len(reg.data))
    print("reg has apple: ", map_has(reg.data, "apple"))
    let res = map_get(reg.data, "banana")
    print("reg get banana: ", res.0, res.1)
    return 0
}
