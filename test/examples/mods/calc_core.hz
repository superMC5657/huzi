// mods/calc_core.hz — 计算模块:四则运算
//
// 输入模块把文本解析成 (a, op, b) 后,由本模块完成实际计算。
// 除零的判断在主程序完成,这里只管算。

fn calculate(a: f64, op: char, b: f64) -> f64 {
    if op == '+' {
        return a + b
    }
    if op == '-' {
        return a - b
    }
    if op == '*' {
        return a * b
    }
    if op == '/' {
        return a / b
    }
    return 0.0
}
