fn main() -> i32 {
    let p1 = parse_int("123")
    print(p1.0, " ", p1.1)
    let p2 = parse_int("-456")
    print(p2.0, " ", p2.1)
    let p3 = parse_int("+789")
    print(p3.0, " ", p3.1)
    let p4 = parse_int("  42  ")
    print(p4.0, " ", p4.1)
    let p_bad1 = parse_int("invalid")
    print(p_bad1.0, " ", p_bad1.1)
    let p_bad2 = parse_int("")
    print(p_bad2.0, " ", p_bad2.1)
    let p_bad3 = parse_int("12abc")
    print(p_bad3.0, " ", p_bad3.1)
    let f1 = parse_float("3.14")
    print(f1.0, " ", f1.1)
    let f2 = parse_float("-0.5")
    print(f2.0, " ", f2.1)
    let f3 = parse_float("  2.718  ")
    print(f3.0, " ", f3.1)
    let f_bad1 = parse_float("invalid")
    print(f_bad1.0, " ", f_bad1.1)
    let f_bad2 = parse_float("")
    print(f_bad2.0, " ", f_bad2.1)
    let f_bad3 = parse_float("1.2.3")
    print(f_bad3.0, " ", f_bad3.1)
    return 0
}
