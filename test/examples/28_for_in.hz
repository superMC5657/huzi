# for-in 数组遍历:for x in arr
# 适用:数组变量、数组字面量、结构体字段数组

# 数值数组求和
let mut total = 0
for n in [10, 20, 30, 40] {
    total = total + n
}
print("sum:", total)

# 字符串数组:循环变量直接绑定字符串
let words = ["huzi", "is", "fun"]
for w in words {
    print(w)
}

# 结构体数组:元素按值绑定,可访问字段
struct Point {
    x: i32,
    y: i32,
}
let pts = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
let mut max_x = 0
for p in pts {
    if p.x > max_x {
        max_x = p.x
    }
}
print("max x:", max_x)

# 范围循环依旧可用
let mut squares = 0
for i in 1..5 {
    squares = squares + i * i
}
print("squares:", squares)
