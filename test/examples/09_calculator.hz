# 简单计算器
# 演示使用函数和控制流实现一个简单计算器

fn add(a: f64, b: f64) -> f64 {
    return a + b
}

fn subtract(a: f64, b: f64) -> f64 {
    return a - b
}

fn multiply(a: f64, b: f64) -> f64 {
    return a * b
}

fn divide(a: f64, b: f64) -> f64 {
    if b == 0.0 {
        print("Error: Division by zero!")
        return 0.0
    }
    return a / b
}

fn power(base: f64, exp: f64) -> f64 {
    return pow(base, exp)
}

fn modulo(a: f64, b: f64) -> f64 {
    if b == 0.0 {
        print("Error: Modulo by zero!")
        return 0.0
    }
    # 转换为整数进行取模
    let ai = a
    let bi = b
    return ai - bi * (a / b)
}

fn calculate(a: f64, b: f64, op: i32) -> f64 {
    # op: 1=+, 2=-, 3=*, 4=/, 5=^
    if op == 1 {
        return add(a, b)
    } elif op == 2 {
        return subtract(a, b)
    } elif op == 3 {
        return multiply(a, b)
    } elif op == 4 {
        return divide(a, b)
    } elif op == 5 {
        return power(a, b)
    }
    return 0.0
}

fn main() -> i32 {
    print("=== 简单计算器 ===\n")
    
    # 测试加法
    print("--- 加法 ---")
    print("10 + 5 = ", calculate(10.0, 5.0, 1))
    print("3.14 + 2.86 = ", calculate(3.14, 2.86, 1))
    
    # 测试减法
    print("\n--- 减法 ---")
    print("10 - 5 = ", calculate(10.0, 5.0, 2))
    print("3.14 - 1.14 = ", calculate(3.14, 1.14, 2))
    
    # 测试乘法
    print("\n--- 乘法 ---")
    print("10 * 5 = ", calculate(10.0, 5.0, 3))
    print("2.5 * 4 = ", calculate(2.5, 4.0, 3))
    
    # 测试除法
    print("\n--- 除法 ---")
    print("10 / 5 = ", calculate(10.0, 5.0, 4))
    print("100 / 4 = ", calculate(100.0, 4.0, 4))
    print("7 / 2 = ", calculate(7.0, 2.0, 4))
    
    # 测试幂运算
    print("\n--- 幂运算 ---")
    print("2 ^ 3 = ", calculate(2.0, 3.0, 5))
    print("10 ^ 2 = ", calculate(10.0, 2.0, 5))
    print("2 ^ 10 = ", calculate(2.0, 10.0, 5))
    
    # 综合测试
    print("\n=== 综合测试 ===")
    let x = 12.0
    let y = 4.0
    
    print("x = ", x, ", y = ", y)
    print("x + y = ", add(x, y))
    print("x - y = ", subtract(x, y))
    print("x * y = ", multiply(x, y))
    print("x / y = ", divide(x, y))
    print("x ^ y = ", power(x, y))
    
    # 复杂表达式
    print("\n=== 复杂表达式 ===")
    # (10 + 5) * 2
    let result1 = multiply(add(10.0, 5.0), 2.0)
    print("(10 + 5) * 2 = ", result1)
    
    # 100 / (5 + 5)
    let result2 = divide(100.0, add(5.0, 5.0))
    print("100 / (5 + 5) = ", result2)
    
    # 2^3 + 4^2
    let result3 = add(power(2.0, 3.0), power(4.0, 2.0))
    print("2^3 + 4^2 = ", result3)
    
    return 0
}
