struct Pair<K, V> {
    key: K,
    val: V,
}

enum Status {
    Ok,
    Err,
}

fn id<T>(x: T) -> T {
    return x
}

fn first<A, B>(a: A, b: B) -> A {
    return a
}

fn second<A, B>(a: A, b: B) -> B {
    return b
}

fn call_id<T>(val: T) -> T {
    return id(val)
}

fn get_pair_key<K, V>(p: Pair<K, V>) -> K {
    return p.key
}

fn main() -> i32 {
    let a = id(42)
    print(a)
    let s = id("hello generics")
    print(s)
    let b = id(true)
    print(b)
    let f = first(100, "skip")
    print(f)
    let sec = second("skip", 200)
    print(sec)
    let nested = call_id(999)
    print(nested)
    let pair = Pair<i32, str> { key: 88, val: "generic_struct" }
    let pk = get_pair_key(pair)
    print(pk)
    let st = id(Status::Ok)
    print(st)
    return 0
}
