import std.fsx
import std.json

fn main() -> i32 {
    let in_path = "test/out/std_demo_in.txt"
    let out_path = "test/out/std_demo_out.json"
    let mut lines = vec<str>()
    push(lines, "item_a")
    push(lines, "item_b")
    fsx::write_lines(in_path, lines)
    let read_res = fsx::read_lines(in_path)
    let r_lines: vec<str> = read_res.1
    let mut m = map_new()
    let mut i = 0
    while i < len(r_lines) {
        map_put(m, r_lines[i], i + 1)
        i = i + 1
    }
    let json_text = json::stringify_map(m, r_lines)
    print("json: ", json_text)
    let mut out_v = vec<str>()
    push(out_v, json_text)
    let write_ok = fsx::write_lines(out_path, out_v)
    print("write_ok: ", write_ok)
    let read_back = fsx::read_lines(out_path)
    let back_lines: vec<str> = read_back.1
    let parse_res = json::parse_i32_map(back_lines[0])
    print("parse_ok: ", parse_res.0)
    let back_m: Map = parse_res.1
    print("item_a: ", map_get(back_m, "item_a").1)
    print("item_b: ", map_get(back_m, "item_b").1)
    return 0
}
