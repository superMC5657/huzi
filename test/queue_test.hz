import alloc.queue
import core.assert

fn main() -> i32 {
    let mut st = vec<i32>()
    let top_empty = queue::stack_top(st)
    assert::assert_true(!top_empty.0)
    let pop_empty = queue::stack_pop(st)
    assert::assert_true(!pop_empty.0)
    queue::stack_push(st, 10)
    queue::stack_push(st, 20)
    queue::stack_push(st, 30)
    assert::assert_eq_i32(len(st), 3)
    let top1 = queue::stack_top(st)
    assert::assert_true(top1.0)
    assert::assert_eq_i32(top1.1, 30)
    let p1 = queue::stack_pop(st)
    assert::assert_true(p1.0)
    assert::assert_eq_i32(p1.1, 30)
    assert::assert_eq_i32(len(st), 2)
    let p2 = queue::stack_pop(st)
    assert::assert_true(p2.0)
    assert::assert_eq_i32(p2.1, 20)
    assert::assert_eq_i32(len(st), 1)
    let mut q = vec<i32>()
    let q_front_empty = queue::queue_front(q)
    assert::assert_true(!q_front_empty.0)
    let q_pop_empty = queue::queue_pop(q)
    assert::assert_true(!q_pop_empty.0)
    queue::queue_push(q, 100)
    queue::queue_push(q, 200)
    assert::assert_eq_i32(len(q), 2)
    let qf = queue::queue_front(q)
    assert::assert_true(qf.0)
    assert::assert_eq_i32(qf.1, 100)
    let qp1 = queue::queue_pop(q)
    assert::assert_true(qp1.0)
    assert::assert_eq_i32(qp1.1, 100)
    assert::assert_eq_i32(len(q), 1)
    let qp2 = queue::queue_pop(q)
    assert::assert_true(qp2.0)
    assert::assert_eq_i32(qp2.1, 200)
    assert::assert_eq_i32(len(q), 0)
    print("queue_test: ok")
    return 0
}
