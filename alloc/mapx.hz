fn map_get_or(m: Map, k: str, dflt: i32) -> i32 {
    let r = map_get(m, k)
    if r.0 {
        return r.1
    } else {
        return dflt
    }
}

fn map_contains_key(m: Map, k: str) -> bool {
    return map_has(m, k)
}

fn map_merge(dst: Map, src: Map) -> i32 {
    return 0
}

fn map_merge_keys(dst: Map, src: Map, keys: vec<str>) -> i32 {
    for k in keys {
        let r = map_get(src, k)
        if r.0 {
            map_put(dst, k, r.1)
        }
    }
    return 0
}
