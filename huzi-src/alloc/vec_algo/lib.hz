fn quicksort_i32(v: vec<i32>, low: i32, high: i32) -> i32 {
    if low < high {
        let mid = low + (high - low) / 2
        let tmp0 = v[mid]
        v[mid] = v[high]
        v[high] = tmp0
        let pivot = v[high]
        let mut i = low - 1
        let mut j = low
        while j < high {
            if v[j] <= pivot {
                i = i + 1
                let tmp = v[i]
                v[i] = v[j]
                v[j] = tmp
            }
            j = j + 1
        }
        let tmp2 = v[i + 1]
        v[i + 1] = v[high]
        v[high] = tmp2
        let p = i + 1
        quicksort_i32(v, low, p - 1)
        quicksort_i32(v, p + 1, high)
    }
    return 0
}

fn vec_sort_i32(v: vec<i32>) -> i32 {
    let n = len(v)
    if n <= 1 {
        return 0
    }
    quicksort_i32(v, 0, n - 1)
    return 0
}

fn vec_binary_search_i32(v: vec<i32>, x: i32) -> i32 {
    let mut low = 0
    let mut high = len(v) - 1
    while low <= high {
        let mid = low + (high - low) / 2
        let val = v[mid]
        if val == x {
            return mid
        }
        if val < x {
            low = mid + 1
        } else {
            high = mid - 1
        }
    }
    return -1
}

fn vec_reverse_i32(v: vec<i32>) -> i32 {
    let mut i = 0
    let mut j = len(v) - 1
    while i < j {
        let tmp = v[i]
        v[i] = v[j]
        v[j] = tmp
        i = i + 1
        j = j - 1
    }
    return 0
}

fn vec_sum_i32(v: vec<i32>) -> i32 {
    let mut s = 0
    for x in v {
        s = s + x
    }
    return s
}

fn vec_max_i32(v: vec<i32>) -> (bool, i32) {
    let n = len(v)
    if n == 0 {
        return (false, 0)
    }
    let mut m = v[0]
    let mut i = 1
    while i < n {
        if v[i] > m {
            m = v[i]
        }
        i = i + 1
    }
    return (true, m)
}

fn vec_min_i32(v: vec<i32>) -> (bool, i32) {
    let n = len(v)
    if n == 0 {
        return (false, 0)
    }
    let mut m = v[0]
    let mut i = 1
    while i < n {
        if v[i] < m {
            m = v[i]
        }
        i = i + 1
    }
    return (true, m)
}

fn vec_dedup_i32(v: vec<i32>) -> i32 {
    let n = len(v)
    if n <= 1 {
        return 0
    }
    let mut i = 1
    while i < len(v) {
        if v[i] == v[i - 1] {
            remove(v, i)
        } else {
            i = i + 1
        }
    }
    return 0
}

fn vec_map<T, U>(v: vec<T>, f: fn(T) -> U) -> vec<U> {
    let mut res = vec<U>()
    for x in v {
        push(res, f(x))
    }
    return res
}

fn vec_filter<T>(v: vec<T>, pred: fn(T) -> bool) -> vec<T> {
    let mut res = vec<T>()
    for x in v {
        if pred(x) {
            push(res, x)
        }
    }
    return res
}

fn vec_fold<T, Acc>(v: vec<T>, init: Acc, f: fn(Acc, T) -> Acc) -> Acc {
    let mut acc = init
    for x in v {
        acc = f(acc, x)
    }
    return acc
}

fn map<T, U>(v: vec<T>, f: fn(T) -> U) -> vec<U> {
    return vec_map(v, f)
}

fn filter<T>(v: vec<T>, pred: fn(T) -> bool) -> vec<T> {
    return vec_filter(v, pred)
}

fn fold<T, Acc>(v: vec<T>, init: Acc, f: fn(Acc, T) -> Acc) -> Acc {
    return vec_fold(v, init, f)
}

fn vec_any<T>(v: vec<T>, pred: fn(T) -> bool) -> bool {
    for x in v {
        if pred(x) {
            return true
        }
    }
    return false
}

fn any<T>(v: vec<T>, pred: fn(T) -> bool) -> bool {
    return vec_any(v, pred)
}

fn vec_all<T>(v: vec<T>, pred: fn(T) -> bool) -> bool {
    for x in v {
        if !pred(x) {
            return false
        }
    }
    return true
}

fn all<T>(v: vec<T>, pred: fn(T) -> bool) -> bool {
    return vec_all(v, pred)
}

fn vec_count<T>(v: vec<T>, pred: fn(T) -> bool) -> i32 {
    let mut cnt = 0
    for x in v {
        if pred(x) {
            cnt = cnt + 1
        }
    }
    return cnt
}

fn count<T>(v: vec<T>, pred: fn(T) -> bool) -> i32 {
    return vec_count(v, pred)
}

fn vec_take<T>(v: vec<T>, n: i32) -> vec<T> {
    let mut res = vec<T>()
    let total = len(v)
    let mut limit = n
    if limit > total {
        limit = total
    }
    let mut i = 0
    while i < limit {
        push(res, v[i])
        i = i + 1
    }
    return res
}

fn take<T>(v: vec<T>, n: i32) -> vec<T> {
    return vec_take(v, n)
}

fn vec_skip<T>(v: vec<T>, n: i32) -> vec<T> {
    let mut res = vec<T>()
    let total = len(v)
    let mut start = n
    if start < 0 {
        start = 0
    }
    let mut i = start
    while i < total {
        push(res, v[i])
        i = i + 1
    }
    return res
}

fn skip<T>(v: vec<T>, n: i32) -> vec<T> {
    return vec_skip(v, n)
}

fn vec_for_each<T>(v: vec<T>, f: fn(T)) -> i32 {
    for x in v {
        f(x)
    }
    return 0
}

fn for_each<T>(v: vec<T>, f: fn(T)) -> i32 {
    return vec_for_each(v, f)
}



