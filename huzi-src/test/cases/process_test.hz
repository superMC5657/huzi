import core.assert

fn main() -> i32 {
    // 拆参迁移: Command{program,args} 按值传递被禁,改走标量 cmd:str 直调内置
    let out = process_run("echo test_process_run")
    assert::assert_true(out.0 == 0)
    assert::assert_true(out.0 == 0)
    assert::assert_true(contains(out.1, "test_process_run"))
    let prog = "echo"
    let arg = "builder_arg"
    let cmd_str = concat(concat(prog, " "), arg)
    let out2 = process_run(cmd_str)
    assert::assert_true(out2.0 == 0)
    assert::assert_true(out2.0 == 0)
    assert::assert_true(contains(out2.1, "builder_arg"))
    print("process_test passed")
    return 0
}
