// JSON 序列化与解析(平面 Map/字段),嵌套查询见 std::jsonq 或
// 本模块的 get/get_str/get_int/get_bool/array_len/type_of 包装。

import std.jsonq

struct JsonField {
    key: str,
    val: str,
}

fn check_tail_end(s: str, close_idx: i32) -> bool {
    let tail = jsonq::skip_ws(s, close_idx + 1)
    return tail == len(s)
}

fn stringify_map(m: Map, keys: vec<str>) -> str {
    let n = len(keys)
    let mut res = "{"
    let mut i = 0
    while i < n {
        let k = keys[i]
        let v_res = map_get(m, k)
        let v = v_res.1
        let entry = concat("\"", jsonq::escape_json_str(k), "\":", to_string(v))
        if i > 0 {
            res = concat(res, ",", entry)
        } else {
            res = concat(res, entry)
        }
        i = i + 1
    }
    return concat(res, "}")
}

fn stringify_i32_map(m: Map) -> str {
    let keys = map_keys(m)
    return stringify_map(m, keys)
}

fn parse_i32_map(s: str) -> (bool, Map) {
    let mut res_map = map_new()
    let n = len(s)
    let mut i = jsonq::skip_ws(s, 0)
    if i >= n {
        return (false, res_map)
    }
    if substring(s, i, i + 1) != "{" {
        return (false, res_map)
    }
    i = jsonq::skip_ws(s, i + 1)
    if i < n {
        if substring(s, i, i + 1) == "}" {
            if check_tail_end(s, i) {
                return (true, res_map)
            }
            return (false, res_map)
        }
    }
    while i < n {
        let key_res = jsonq::parse_json_string(s, i)
        if !key_res.0 {
            return (false, res_map)
        }
        let key = key_res.1
        i = jsonq::skip_ws(s, key_res.2)
        if i >= n {
            return (false, res_map)
        }
        if substring(s, i, i + 1) != ":" {
            return (false, res_map)
        }
        i = jsonq::skip_ws(s, i + 1)
        let start_val = i
        while i < n {
            let ch = substring(s, i, i + 1)
            if ch == "," {
                break
            }
            if ch == "}" {
                break
            }
            if jsonq::is_ws(ch) {
                break
            }
            i = i + 1
        }
        let num_str = substring(s, start_val, i)
        let p_res = parse_int(num_str)
        if !p_res.0 {
            return (false, res_map)
        }
        map_put(res_map, key, p_res.1)
        i = jsonq::skip_ws(s, i)
        if i >= n {
            return (false, res_map)
        }
        let next_tok = substring(s, i, i + 1)
        if next_tok == "," {
            i = jsonq::skip_ws(s, i + 1)
        } elif next_tok == "}" {
            if check_tail_end(s, i) {
                return (true, res_map)
            }
            return (false, res_map)
        } else {
            return (false, res_map)
        }
    }
    return (false, res_map)
}

fn stringify_fields(fields: vec<JsonField>) -> str {
    let n = len(fields)
    let mut res = "{"
    let mut i = 0
    while i < n {
        let item = fields[i]
        let entry = concat("\"", jsonq::escape_json_str(item.key), "\":\"", jsonq::escape_json_str(item.val), "\"")
        if i > 0 {
            res = concat(res, ",", entry)
        } else {
            res = concat(res, entry)
        }
        i = i + 1
    }
    return concat(res, "}")
}

fn parse_str_fields(s: str) -> (bool, vec<JsonField>) {
    let mut fields = vec<JsonField>()
    let n = len(s)
    let mut i = jsonq::skip_ws(s, 0)
    if i >= n {
        return (false, fields)
    }
    if substring(s, i, i + 1) != "{" {
        return (false, fields)
    }
    i = jsonq::skip_ws(s, i + 1)
    if i < n {
        if substring(s, i, i + 1) == "}" {
            if check_tail_end(s, i) {
                return (true, fields)
            }
            return (false, fields)
        }
    }
    while i < n {
        let key_res = jsonq::parse_json_string(s, i)
        if !key_res.0 {
            return (false, fields)
        }
        let key = key_res.1
        i = jsonq::skip_ws(s, key_res.2)
        if i >= n {
            return (false, fields)
        }
        if substring(s, i, i + 1) != ":" {
            return (false, fields)
        }
        i = jsonq::skip_ws(s, i + 1)
        let val_res = jsonq::parse_json_string(s, i)
        if !val_res.0 {
            return (false, fields)
        }
        push(fields, JsonField { key: key, val: val_res.1 })
        i = jsonq::skip_ws(s, val_res.2)
        if i >= n {
            return (false, fields)
        }
        let next_tok = substring(s, i, i + 1)
        if next_tok == "," {
            i = jsonq::skip_ws(s, i + 1)
        } elif next_tok == "}" {
            if check_tail_end(s, i) {
                return (true, fields)
            }
            return (false, fields)
        } else {
            return (false, fields)
        }
    }
    return (false, fields)
}

// ---- 嵌套查询包装(实现在 std::jsonq,路径形如 "user.tags.0") ----

/// 按路径取值的 JSON 原文;空路径为整个文档。
fn get(s: str, path: str) -> (bool, str) {
    return jsonq::get_raw(s, path)
}

/// 字符串值(解码转义含 \uXXXX → UTF-8)。
fn get_str(s: str, path: str) -> (bool, str) {
    return jsonq::get_str(s, path)
}

/// 数值。
fn get_int(s: str, path: str) -> (bool, i32) {
    return jsonq::get_int(s, path)
}

/// 布尔值。
fn get_bool(s: str, path: str) -> (bool, bool) {
    return jsonq::get_bool(s, path)
}

/// 数组长度。
fn array_len(s: str, path: str) -> (bool, i32) {
    return jsonq::array_len(s, path)
}

/// 值类型:"object"/"array"/"string"/"number"/"bool"/"null"/""。
fn type_of(s: str, path: str) -> str {
    return jsonq::type_of(s, path)
}
