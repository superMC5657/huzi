{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Huzi",
  "scopeName": "source.huzi",
  "fileTypes": ["hz"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#definitions" },
    { "include": "#builtins" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.huzi",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.huzi",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.huzi",
          "begin": "([fF])(\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.huzi" },
            "2": { "name": "punctuation.definition.string.begin.huzi" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.huzi" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.huzi",
              "match": "\\\\(n|t|r|\\\\|\"|0)"
            },
            {
              "name": "constant.character.escape.huzi",
              "match": "(\\{\\{|\\}\\})"
            },
            {
              "name": "meta.interpolation.huzi",
              "begin": "\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.embedded.begin.huzi" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.embedded.end.huzi" }
              },
              "patterns": [
                { "include": "#strings" },
                { "include": "#numbers" },
                { "include": "#constants" },
                { "include": "#definitions" },
                { "include": "#builtins" },
                { "include": "#operators" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.huzi",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.huzi",
              "match": "\\\\(n|t|r|\\\\|\"|0)"
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.huzi",
          "match": "'(\\\\(n|t|r|\\\\|'|0)|[^\\\\'])'"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.huzi",
          "match": "\\b(fn|let|mut|if|elif|else|for|in|while|return|break|continue|import|export|defer|trait|impl|match|struct|enum|weak)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.huzi",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.huzi",
          "match": "\\b(i32|i64|u32|u64|f32|f64|bool|str|char|Box|vec|Map|HashMap|Option|Result|Self)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.huzi",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.huzi",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "name": "meta.function.huzi",
          "begin": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "keyword.control.huzi" },
            "2": { "name": "entity.name.function.huzi" }
          },
          "end": "(?=\\()",
          "patterns": [{ "include": "#types" }]
        },
        {
          "name": "meta.struct.huzi",
          "begin": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "keyword.control.huzi" },
            "2": { "name": "entity.name.type.huzi" }
          },
          "end": "(?=\\{)",
          "patterns": [{ "include": "#types" }]
        },
        {
          "name": "meta.enum.huzi",
          "begin": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "keyword.control.huzi" },
            "2": { "name": "entity.name.type.huzi" }
          },
          "end": "(?=\\{)",
          "patterns": [{ "include": "#types" }]
        },
        {
          "name": "entity.name.function.call.huzi",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.stdlib.huzi",
          "match": "\\b(print|format|vec|push|pop|remove|insert|clear|box|len|concat|to_string|abs|sqrt|pow|sin|cos|tan|floor|ceil|round|srand|rand|time|localtime|env_get|exit|panic|sleep_ms|process_run|read_line|read_int|read_float|is_eof|arg_count|arg|arg_ok|split|substring|trim|contains|parse_int|parse_float|read_file|read_file_ok|read_file_err|write_file|free_str|free_vec|free_box|ref_count|weak_count|map_new|map_put|map_get|map_has|map_remove|map_len|map_keys|tcp_connect|tcp_send|tcp_recv|tcp_close|tcp_listen|tcp_accept|spawn|join|chan_new|chan_send|chan_recv|str_from_bytes)\\b"
        },
        {
          "name": "support.module.stdlib.huzi",
          "match": "\\b(math)(?=\\s*::)"
        },
        {
          "name": "constant.other.module.huzi",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*::)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.huzi",
          "match": "(&&|\\|\\||==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|->|=>|::|\\.\\.|[+\\-*/%=<>!&|?])"
        },
        {
          "name": "punctuation.huzi",
          "match": "([{}()\\[\\];,:.])"
        }
      ]
    }
  }
}
