fn read_expression() -> str {
    print(">")
    return read_line()
}

fn find_operator(s: str) -> i32 {
    let mut i = 0
    while i < len(s) {
        let c = s[i]
        if c == '+' || c == '-' || c == '*' || c == '/' {
            return i
        }
        i = i + 1
    }
    return -1
}

fn parse_number(s: str, start: i32, end: i32) -> f64 {
    let mut v = 0.0
    let mut scale = 0.0
    let mut i = start
    while i < end {
        let c = s[i]
        if c == '.' {
            scale = 1.0
        } else {
            if c != ' ' {
                if scale > 0.0 {
                    scale = scale / 10.0
                    v = v + (c - '0') * scale
                } else {
                    v = v * 10.0 + (c - '0')
                }
            }
        }
        i = i + 1
    }
    return v
}
