fn factorial(n: i32) -> i32 {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

fn fibonacci(n: i32) -> i32 {
    if n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

fn power(base: f64, exp: i32) -> f64 {
    if exp == 0 {
        return 1.0
    }
    if exp < 0 {
        return 1.0 / power(base, -exp)
    }
    return base * power(base, exp - 1)
}

fn gcd(a: i32, b: i32) -> i32 {
    if b == 0 {
        return a
    }
    return gcd(b, a % b)
}

fn count_digits(n: i32) -> i32 {
    if n < 10 {
        return 1
    }
    return 1 + count_digits(n / 10)
}

fn array_sum_recursive(arr: i32, index: i32, len: i32) -> i32 {
    if index >= len {
        return 0
    }
    return 0
}

fn main() -> i32 {
    print("=== 阶乘 ===")
    for i in 1..6 {
        print(i, "! = ", factorial(i))
    }
    print("\n=== 斐波那契数列 ===")
    for i in 0..10 {
        print("F(", i, ") = ", fibonacci(i))
    }
    print("\n=== 幂运算 ===")
    print("2^0 = ", power(2.0, 0))
    print("2^1 = ", power(2.0, 1))
    print("2^2 = ", power(2.0, 2))
    print("2^3 = ", power(2.0, 3))
    print("2^4 = ", power(2.0, 4))
    print("2^10 = ", power(2.0, 10))
    print("2^-2 = ", power(2.0, -2))
    print("\n=== 最大公约数 ===")
    print("gcd(48, 18) = ", gcd(48, 18))
    print("gcd(100, 25) = ", gcd(100, 25))
    print("gcd(17, 19) = ", gcd(17, 19))
    print("\n=== 数字位数 ===")
    print("digits(5) = ", count_digits(5))
    print("digits(100) = ", count_digits(100))
    print("digits(9999) = ", count_digits(9999))
    return 0
}
