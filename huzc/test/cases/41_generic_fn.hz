fn id<T>(x: T) -> T {
    return x
}

fn first<A, B>(a: A, b: B) -> A {
    return a
}

fn second<A, B>(a: A, b: B) -> B {
    return b
}

fn call_id<T>(val: T) -> T {
    return id<T>(val)
}

fn main() -> i32 {
    let a = id<i32>(42)
    print(a)
    let s = id<str>("hello generics")
    print(s)
    let b = id<bool>(true)
    print(b)
    let f = first<i32, str>(100, "skip")
    print(f)
    let sec = second<str, i32>("skip", 200)
    print(sec)
    let nested = call_id<i32>(999)
    print(nested)
    return 0
}
