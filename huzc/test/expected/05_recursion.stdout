=== 阶乘 ===
1! = 1
2! = 2
3! = 6
4! = 24
5! = 120

=== 斐波那契数列 ===
F(0) = 0
F(1) = 1
F(2) = 1
F(3) = 2
F(4) = 3
F(5) = 5
F(6) = 8
F(7) = 13
F(8) = 21
F(9) = 34

=== 幂运算 ===
2^0 = 1.000000
2^1 = 2.000000
2^2 = 4.000000
2^3 = 8.000000
2^4 = 16.000000
2^10 = 1024.000000
2^-2 = 0.250000

=== 最大公约数 ===
gcd(48, 18) = 6
gcd(100, 25) = 25
gcd(17, 19) = 1

=== 数字位数 ===
digits(5) = 1
digits(100) = 3
digits(9999) = 4
