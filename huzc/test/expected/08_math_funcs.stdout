=== 绝对值 abs() ===
abs(-42) = 42
abs(42) = 42
abs(-3.14) = 3.140000
abs(0) = 0

=== 平方根 sqrt() ===
sqrt(0) = 0.000000
sqrt(1) = 1.000000
sqrt(4) = 2.000000
sqrt(9) = 3.000000
sqrt(16) = 4.000000
sqrt(2) = 1.414214
sqrt(100) = 10.000000

=== 幂运算 pow() ===
pow(2, 0) = 1.000000
pow(2, 1) = 2.000000
pow(2, 2) = 4.000000
pow(2, 3) = 8.000000
pow(2, 10) = 1024.000000
pow(10, 3) = 1000.000000
pow(3, 4) = 81.000000

=== 三角函数 ===
--- sin() ---
sin(0) = 0.000000
sin(π/2) ≈ 1.000000
sin(π) ≈ 0.000000

--- cos() ---
cos(0) = 1.000000
cos(π/2) ≈ 0.000000
cos(π) ≈ -1.000000

=== 综合数学计算 ===
Circle area (r=5): 78.539816
Triangle hypotenuse (3,4): 5.000000
Compound interest (1000@5% for 10y): 1628.894627
